+        written: Vec<u8>,
+        flushes: usize,
+    }
+
+    impl Wire {
+        fn new(inbound: Vec<u8>) -> Self {
+            Self { inbound: Cursor::new(inbound), written: Vec::new(), flushes: 0 }
+        }
+    }
+
+    impl io::Read for Wire {
+        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
