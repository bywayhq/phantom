+        let config = if deflate {
+            WebSocketConfig::default().enable_deflate()
+        } else {
+            WebSocketConfig::default()
+        };
+        let mut socket = WebSocket::from_raw_socket(
+            Incoming(Cursor::new(frames.to_vec())),
+            Role::Client,
+            Some(config),
