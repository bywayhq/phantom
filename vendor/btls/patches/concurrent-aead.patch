+/// A shareable context restricted to BoringSSL's generic, stateless AEADs.
+///
+/// BoringSSL documents generic `EVP_AEAD_CTX_seal*` and
+/// `EVP_AEAD_CTX_open*` operations as safe to call concurrently on the same
+/// context. TLS-specific AEADs explicitly do not have that guarantee, so this
+/// type only has named constructors for AES-128-GCM, AES-256-GCM, and
+/// ChaCha20-Poly1305 and does not accept an arbitrary [`Algorithm`].
+pub struct ConcurrentAeadCtx(AeadCtx);
+
+const _: () = {
+    fn assert_send_sync<T: Send + Sync>() {}
+    let _ = assert_send_sync::<ConcurrentAeadCtx>;
+};
+
+impl ConcurrentAeadCtx {
+    /// Creates a concurrent AES-128-GCM context with a full-length tag.
+    pub fn aes_128_gcm(key: &[u8]) -> Result<Self, ErrorStack> {
+        Self::new(&Algorithm::aes_128_gcm(), key)
+    }
+
+    /// Creates a concurrent AES-256-GCM context with a full-length tag.
+    pub fn aes_256_gcm(key: &[u8]) -> Result<Self, ErrorStack> {
+        Self::new(&Algorithm::aes_256_gcm(), key)
+    }
+
+    /// Creates a concurrent ChaCha20-Poly1305 context with a full-length tag.
+    pub fn chacha20_poly1305(key: &[u8]) -> Result<Self, ErrorStack> {
+        Self::new(&Algorithm::chacha20_poly1305(), key)
+    }
+
+    fn new(algorithm: &Algorithm, key: &[u8]) -> Result<Self, ErrorStack> {
+        AeadCtx::new_default_tag(algorithm, key).map(Self)
+    }
+
+    /// Encrypts `buffer` in place and writes a detached authentication tag.
+    ///
+    /// Calls may run concurrently on the same context. The caller must use a
+    /// unique nonce for every message sealed with a given key.
+    pub fn seal_in_place<'a>(
+        &self,
+        nonce: &[u8],
+        buffer: &mut [u8],
+        tag: &'a mut [u8],
+        associated_data: &[u8],
+    ) -> Result<&'a mut [u8], ErrorStack> {
+        #[allow(deprecated)]
+        self.0.seal_in_place(nonce, buffer, tag, associated_data)
+    }
+
+    /// Decrypts `buffer` in place after verifying a detached tag and AAD.
+    ///
+    /// Calls may run concurrently on the same context.
+    pub fn open_in_place(
+        &self,
+        nonce: &[u8],
+        buffer: &mut [u8],
+        tag: &[u8],
+        associated_data: &[u8],
+    ) -> Result<(), ErrorStack> {
+        #[allow(deprecated)]
+        self.0.open_in_place(nonce, buffer, tag, associated_data)
+    }
+}
