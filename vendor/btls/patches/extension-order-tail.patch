+        extensions: &[ExtensionType],
+    ) -> Result<(), ErrorStack> {
+        unsafe {
+            cvt(ffi::SSL_CTX_set_extension_order_tail(
+                self.as_ptr(),
+                extensions.as_ptr() as *const _,
+                extensions.len(),
+            ))
+        }
+    }
