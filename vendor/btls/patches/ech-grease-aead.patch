+#[cfg(not(feature = "fips"))]
+#[test]
+fn ech_grease_uses_a_single_configured_aead() {
+    for aead_id in [0x0001, 0x0002, 0x0003] {
+        let extension = capture_ech_grease_extension_with(|ssl| {
+            ssl.set_ech_grease_aeads(&[aead_id]).unwrap();
+        });
+
+        // ECHClientHelloType, HKDF-SHA256, then the AEAD identifier.
+        assert_eq!(&extension[..3], &[0, 0, 1]);
+        assert_eq!(&extension[3..5], &aead_id.to_be_bytes());
+    }
+}
+
+#[cfg(not(feature = "fips"))]
+#[test]
+fn ech_grease_selects_every_configured_aead() {
+    // Missing either identifier in 32 fair draws has probability 2^-31.
+    let mut observed = std::collections::BTreeSet::new();
+    for _ in 0..32 {
+        let extension = capture_ech_grease_extension_with(|ssl| {
+            ssl.set_ech_grease_aeads(&[0x0001, 0x0003]).unwrap();
+        });
+        observed.insert(u16::from_be_bytes([extension[3], extension[4]]));
+    }
+
+    assert_eq!(observed.into_iter().collect::<Vec<_>>(), [0x0001, 0x0003]);
+}
+
+#[cfg(not(feature = "fips"))]
+#[test]
+fn ech_grease_aeads_reject_invalid_lists() {
+    let context = SslContext::builder(SslMethod::tls()).unwrap().build();
+    let mut ssl = Ssl::new(&context).unwrap();
+
+    for invalid in [
+        &[0x0001, 0x0002, 0x0003, 0x0001][..],
+        &[0x0004][..],
+        &[0x0003, 0x0003][..],
+    ] {
+        let error = ssl.set_ech_grease_aeads(invalid).unwrap_err();
+        assert!(!error.errors().is_empty(), "{invalid:?}");
+    }
+    ssl.set_ech_grease_aeads(&[0x0001, 0x0002, 0x0003]).unwrap();
+    ssl.set_ech_grease_aeads(&[]).unwrap();
+}
