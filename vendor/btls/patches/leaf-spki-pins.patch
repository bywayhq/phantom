+// The ordinary fixture covers foobar.com only. ECH rejection authenticates
+// ech.com instead, so sign a leaf for both with the retained test CA/key.
+fn ech_leaf() -> TestResult<X509> {
+    use crate::{hash::MessageDigest, pkey::PKey, x509::extension::SubjectAlternativeName};
+    let original = X509::from_pem(include_bytes!("../../../test/cert.pem"))?;
+    let root = X509::from_pem(include_bytes!("../../../test/root-ca.pem"))?;
+    let root_key = PKey::private_key_from_pem(include_bytes!("../../../test/root-ca.key"))?;
+    let mut leaf = X509::builder()?;
+    leaf.set_version(2)?;
+    leaf.set_serial_number(original.serial_number())?;
+    leaf.set_subject_name(original.subject_name())?;
+    leaf.set_issuer_name(root.subject_name())?;
+    let public_key = original.public_key()?;
+    leaf.set_pubkey(&public_key)?;
+    leaf.set_not_before(original.not_before())?;
+    leaf.set_not_after(original.not_after())?;
+    let names = SubjectAlternativeName::new()
+        .dns("foobar.com")
+        .dns("ech.com")
+        .build(&leaf.x509v3_context(Some(&root), None))?;
+    leaf.append_extension(&names)?;
+    leaf.sign(&root_key, MessageDigest::sha256())?;
+    Ok(leaf.build())
+}
+
+struct Peer {
+    address: SocketAddr,
+    child: Option<JoinHandle<TestResult<usize>>>,
+}
+
+impl Peer {
+    fn start(accepts_application_data: bool) -> TestResult<Self> {
+        Self::start_many(accepts_application_data, 1, |_| Ok(()))
+    }
+
+    fn start_many(
+        accepts_application_data: bool,
+        connections: usize,
+        configure: impl FnOnce(&mut SslAcceptorBuilder) -> TestResult<()>,
+    ) -> TestResult<Self> {
+        let mut context = SslAcceptor::mozilla_intermediate_v5(SslMethod::tls())?;
+        context.set_certificate_chain_file("test/cert.pem")?;
+        context.set_private_key_file("test/key.pem", SslFiletype::PEM)?;
+        context.check_private_key()?;
+        configure(&mut context)?;
+        let context = context.build();
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0))?;
+        listener.set_nonblocking(true)?;
+        let address = listener.local_addr()?;
+        let child = thread::spawn(move || {
+            let mut received = 0;
+            for _ in 0..connections {
+                let deadline = Instant::now() + Duration::from_secs(5);
+                let socket = loop {
+                    match listener.accept() {
+                        Ok((socket, _)) => break socket,
+                        Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                            if Instant::now() >= deadline {
+                                return Err("pin peer was not connected".into());
+                            }
+                            thread::sleep(Duration::from_millis(1));
+                        }
+                        Err(error) => return Err(error.into()),
+                    }
+                };
+                socket.set_nonblocking(false)?;
+                socket.set_read_timeout(Some(Duration::from_secs(3)))?;
+                socket.set_write_timeout(Some(Duration::from_secs(3)))?;
+                received += match context.accept(socket) {
+                    Ok(mut stream) => {
+                        if let Err(error) = stream.write_all(b"y") {
+                            if accepts_application_data {
+                                return Err(error.into());
+                            }
+                            continue;
+                        }
+                        let mut byte = [0];
+                        match stream.read(&mut byte) {
+                            Ok(length) => Ok::<usize, Box<dyn Error + Send + Sync>>(length),
+                            Err(_) if !accepts_application_data => Ok(0),
+                            Err(error) => Err(error.into()),
+                        }
+                    }
+                    Err(_) if !accepts_application_data => Ok(0),
+                    Err(error) => Err(format!("pin peer handshake failed: {error:?}").into()),
+                }?;
+            }
+            Ok(received)
+        });
+        Ok(Self {
+            address,
+            child: Some(child),
+        })
+    }
+
+    fn finish(mut self) -> TestResult<usize> {
+        self.child
+            .take()
+            .ok_or("pin peer missing")?
+            .join()
+            .map_err(|_| "pin peer panicked")?
+    }
+}
+
+impl Drop for Peer {
+    fn drop(&mut self) {
+        if let Some(child) = self.child.take() {
+            // A panic still owns this bounded peer through termination.
+            let result = child.join();
+            if !matches!(result, Ok(Ok(_))) {
+                eprintln!("pin peer cleanup failed: {result:?}");
+            }
+        }
+    }
+}
