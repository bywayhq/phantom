+    /// Returns the application settings received from the peer through ALPS.
+    ///
+    /// `None` means ALPS was not negotiated. `Some(&[])` means it was negotiated
+    /// and the peer sent an empty settings value.
+    #[corresponds(SSL_get0_peer_application_settings)]
+    #[must_use]
+    pub fn peer_application_settings(&self) -> Option<&[u8]> {
+        unsafe {
+            if ffi::SSL_has_application_settings(self.as_ptr()) == 0 {
+                return None;
+            }
+
+            let mut data: *const c_uchar = ptr::null();
+            let mut len = 0;
+            ffi::SSL_get0_peer_application_settings(self.as_ptr(), &mut data, &mut len);
+
+            if len == 0 {
+                Some(&[])
+            } else if data.is_null() {
+                None
+            } else {
+                // BoringSSL guarantees a live `len`-byte buffer when `len` is nonzero.
+                Some(slice::from_raw_parts(data, len))
+            }
+        }
+    }
