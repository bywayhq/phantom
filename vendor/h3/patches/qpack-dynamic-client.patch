+struct CountWake(AtomicUsize);
+
+impl ArcWake for CountWake {
+    fn wake_by_ref(arc_self: &Arc<Self>) {
+        arc_self.0.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
