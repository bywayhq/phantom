+/// Resets a request stream whose `send_request` future is dropped before its
+/// HEADERS frame is written
+///
+/// Quinn finishes a send stream that is dropped, so a `send_request` future
+/// dropped while its HEADERS frame waits for flow control would end the stream
+/// after a truncated frame, which RFC 9114 section 7.1 makes a connection
+/// error. The guard resets the stream and stops it with
+/// `H3_REQUEST_CANCELLED` (RFC 9114 section 8.1) instead, which ends only
+/// this stream. A write that completes, or fails, keeps the stream.
+struct ResetUnsentRequest<'a, S, B>
+where
+    S: quic::SendStream<B> + quic::RecvStream,
+    B: Buf,
+{
+    stream: &'a mut S,
+    kept: bool,
+    _buf: PhantomData<fn(B)>,
+}
+
+impl<'a, S, B> ResetUnsentRequest<'a, S, B>
+where
+    S: quic::SendStream<B> + quic::RecvStream,
+    B: Buf,
+{
+    fn new(stream: &'a mut S) -> Self {
+        Self {
+            stream,
+            kept: false,
+            _buf: PhantomData,
+        }
+    }
+
+    /// Keeps the stream once the HEADERS write has completed or failed
+    fn keep(mut self) {
+        self.kept = true;
+    }
+}
+
+impl<S, B> Deref for ResetUnsentRequest<'_, S, B>
+where
+    S: quic::SendStream<B> + quic::RecvStream,
+    B: Buf,
+{
+    type Target = S;
+
+    fn deref(&self) -> &S {
+        self.stream
+    }
+}
+
+impl<S, B> DerefMut for ResetUnsentRequest<'_, S, B>
+where
+    S: quic::SendStream<B> + quic::RecvStream,
+    B: Buf,
+{
+    fn deref_mut(&mut self) -> &mut S {
+        self.stream
+    }
+}
+
+impl<S, B> Drop for ResetUnsentRequest<'_, S, B>
+where
+    S: quic::SendStream<B> + quic::RecvStream,
+    B: Buf,
+{
+    fn drop(&mut self) {
+        if !self.kept {
+            let code = Code::H3_REQUEST_CANCELLED.value();
+            self.stream.reset(code);
+            self.stream.stop_sending(code);
+        }
+    }
+}
+
 impl<T, B> Clone for SendRequest<T, B>
 where
     T: quic::OpenStreams<B> + Clone,
