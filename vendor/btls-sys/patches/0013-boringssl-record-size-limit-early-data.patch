+TEST(SSLTest, RecordSizeLimitKeepsProtocolMaximumForWholeEarlyEpoch) {
+  bssl::UniquePtr<SSL_CTX> client_ctx(SSL_CTX_new(TLS_method()));
+  bssl::UniquePtr<SSL_CTX> server_ctx =
+      CreateContextWithTestCertificate(TLS_method());
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  ConfigureRecordSizeLimitEarlyData(client_ctx.get(), server_ctx.get());
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(client_ctx.get(), 16385));
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(server_ctx.get(), 16385));
+
+  bssl::UniquePtr<SSL_SESSION> session =
+      CreateClientSession(client_ctx.get(), server_ctx.get());
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_early_data_capable(session.get()));
+
+  // The server accepts 0-RTT and then advertises 1024 in EncryptedExtensions.
+  EarlyDataRecordSizeLimitState state;
+  state.forced_server_limit = 1024;
+  SSL_CTX_set_msg_callback(client_ctx.get(),
+                           EarlyDataRecordSizeLimitMsgCallback);
+  SSL_CTX_set_msg_callback_arg(client_ctx.get(), &state);
+  SSL_CTX_set_msg_callback(server_ctx.get(),
+                           EarlyDataRecordSizeLimitMsgCallback);
+  SSL_CTX_set_msg_callback_arg(server_ctx.get(), &state);
+
+  bssl::UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx.get(),
+                                    server_ctx.get()));
+  SSL_set_session(client.get(), session.get());
+  ASSERT_EQ(1, SSL_do_handshake(client.get()));
+  ASSERT_TRUE(SSL_in_early_data(client.get()));
+  ASSERT_EQ(1, SSL_do_handshake(server.get()));
+  ASSERT_TRUE(SSL_in_early_data(server.get()));
+  ASSERT_EQ(1, SSL_do_handshake(client.get()));
+  EXPECT_TRUE(SSL_early_data_accepted(client.get()));
+
+  // After EncryptedExtensions, the rest of the 0-RTT epoch, including
+  // EndOfEarlyData, keeps the protocol maximum. The server's limit applies from
+  // the handshake write keys, starting with Finished.
+  EXPECT_EQ(state.limit_at_end_of_early_data, 0);
+  EXPECT_EQ(state.limit_at_finished, 1024);
+  EXPECT_EQ(FromOpaque(client.get())->s3->write_record_size_limit, 1024);
+}
