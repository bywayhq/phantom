+struct EarlyDataRecordSizeLimitState {
+  // If non-zero, the server advertises this limit after accepting 0-RTT, as a
+  // server that ignores the protocol maximum might.
+  uint16_t forced_server_limit = 0;
+  // The client's write limit when it queues EndOfEarlyData and Finished.
+  int limit_at_end_of_early_data = -1;
+  int limit_at_finished = -1;
+};
+
+static void EarlyDataRecordSizeLimitMsgCallback(int is_write,
+                                                int /*cb_version*/,
+                                                int cb_type, const void *buf,
+                                                size_t len, SSL *ssl,
+                                                void *arg) {
+  auto *state = static_cast<EarlyDataRecordSizeLimitState *>(arg);
+  const auto bytes = Span(static_cast<const uint8_t *>(buf), len);
+  if (!is_write || cb_type != SSL3_RT_HANDSHAKE || bytes.empty()) {
+    return;
+  }
+  SSLImpl *impl = FromOpaque(ssl);
+  if (impl->server) {
+    // ServerHello is written after the 0-RTT decision and before
+    // EncryptedExtensions.
+    if (state->forced_server_limit != 0 && bytes[0] == SSL3_MT_SERVER_HELLO) {
+      impl->s3->hs->record_size_limit = state->forced_server_limit;
+    }
+    return;
+  }
+  if (bytes[0] == SSL3_MT_END_OF_EARLY_DATA) {
+    state->limit_at_end_of_early_data = impl->s3->write_record_size_limit;
+  } else if (bytes[0] == SSL3_MT_FINISHED) {
+    state->limit_at_finished = impl->s3->write_record_size_limit;
+  }
+}
