+static void ConfigureRecordSizeLimitEarlyData(SSL_CTX *client_ctx,
+                                              SSL_CTX *server_ctx) {
+  ConfigureVersion(client_ctx, TLS1_3_VERSION);
+  ConfigureVersion(server_ctx, TLS1_3_VERSION);
+  SSL_CTX_set_early_data_enabled(client_ctx, 1);
+  SSL_CTX_set_early_data_enabled(server_ctx, 1);
+  SSL_CTX_set_session_cache_mode(client_ctx, SSL_SESS_CACHE_BOTH);
+  SSL_CTX_set_session_cache_mode(server_ctx, SSL_SESS_CACHE_BOTH);
+}
+
+// ReadFully reads exactly `out.size()` bytes from `ssl`.
+static bool ReadFully(SSL *ssl, Span<uint8_t> out) {
+  while (!out.empty()) {
+    int ret = SSL_read(ssl, out.data(), static_cast<int>(out.size()));
+    if (ret <= 0) {
+      return false;
+    }
+    out = out.subspan(static_cast<size_t>(ret));
+  }
+  return true;
+}
