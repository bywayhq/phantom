+      CreateClientSession(client_ctx.get(), server_ctx.get());
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_early_data_capable(session.get()));
+
+  // The server would also decline 0-RTT for its limit, but HelloRetryRequest
+  // is reported first.
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(server_ctx.get(), 512));
+  bssl::UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx.get(),
+                                    server_ctx.get()));
+  const uint16_t client_groups[] = {SSL_GROUP_X25519, SSL_GROUP_SECP256R1};
+  const uint16_t client_key_shares[] = {SSL_GROUP_X25519};
+  const uint16_t server_groups[] = {SSL_GROUP_SECP256R1};
+  ASSERT_TRUE(SSL_set1_group_ids(client.get(), client_groups,
+                                 std::size(client_groups)));
+  ASSERT_TRUE(SSL_set1_client_key_shares(client.get(), client_key_shares,
+                                         std::size(client_key_shares)));
+  ASSERT_TRUE(SSL_set1_group_ids(server.get(), server_groups,
+                                 std::size(server_groups)));
+  SSL_set_session(client.get(), session.get());
+  ASSERT_EQ(1, SSL_do_handshake(client.get()));
+  ASSERT_TRUE(SSL_in_early_data(client.get()));
+  std::vector<uint8_t> early(2000, 'E');
+  ASSERT_EQ(static_cast<int>(early.size()),
+            SSL_write(client.get(), early.data(), early.size()));
+
+  // The server sends HelloRetryRequest and skips the early record, larger than
+  // its limit, under the null cipher.
+  ASSERT_EQ(-1, SSL_do_handshake(server.get()));
