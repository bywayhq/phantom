+  EXPECT_TRUE(SSL_session_reused(client.get()));
+  EXPECT_EQ(SSL_get_early_data_reason(client.get()),
+            ssl_early_data_hello_retry_request);
+  EXPECT_EQ(FromOpaque(client.get())->s3->write_record_size_limit, 512);
