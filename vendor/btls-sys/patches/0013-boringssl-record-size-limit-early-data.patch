+  SSL_CTX_set_msg_callback(server_ctx.get(),
+                           EarlyDataRecordSizeLimitMsgCallback);
+  SSL_CTX_set_msg_callback_arg(server_ctx.get(), &state);
+
+  bssl::UniquePtr<SSL> client(SSL_new(client_ctx.get()));
+  bssl::UniquePtr<SSL> server(SSL_new(server_ctx.get()));
+  ASSERT_TRUE(client);
+  ASSERT_TRUE(server);
+  SSL_set_connect_state(client.get());
+  SSL_set_accept_state(server.get());
+  // The client's transport holds 4096 bytes, less than one 0-RTT record.
+  BIO *client_bio, *server_bio;
+  ASSERT_TRUE(BIO_new_bio_pair(&client_bio, 4096, &server_bio, 0));
+  SSL_set_bio(client.get(), client_bio, client_bio);
+  SSL_set_bio(server.get(), server_bio, server_bio);
+  SSL_set_session(client.get(), session.get());
+
+  ASSERT_EQ(1, SSL_do_handshake(client.get()));
+  ASSERT_TRUE(SSL_in_early_data(client.get()));
+  std::vector<uint8_t> data(20000);
+  for (size_t i = 0; i < data.size(); i++) {
+    data[i] = static_cast<uint8_t>(i);
+  }
+  ASSERT_EQ(-1, SSL_write(client.get(), data.data(), data.size()));
+  ASSERT_EQ(SSL_ERROR_WANT_WRITE, SSL_get_error(client.get(), -1));
+
+  std::vector<uint8_t> received;
+  auto drain_server = [&]() -> bool {
+    uint8_t buf[4096];
+    for (;;) {
+      int ret = SSL_read(server.get(), buf, sizeof(buf));
+      if (ret > 0) {
+        received.insert(received.end(), buf, buf + ret);
+        continue;
+      }
+      return SSL_get_error(server.get(), ret) == SSL_ERROR_WANT_READ;
+    }
+  };
+
+  // Complete the handshake while the 0-RTT record is still pending. The
+  // server's 1024-byte limit then applies to the write keys.
+  for (int i = 0; i < 64 && SSL_in_init(client.get()); i++) {
+    int ret = SSL_do_handshake(client.get());
+    int err = SSL_get_error(client.get(), ret);
+    ASSERT_TRUE(ret == 1 || err == SSL_ERROR_WANT_READ ||
+                err == SSL_ERROR_WANT_WRITE)
+        << err;
+    ASSERT_TRUE(drain_server());
+  }
+  ASSERT_FALSE(SSL_in_init(client.get()));
+  EXPECT_TRUE(SSL_early_data_accepted(client.get()));
+  EXPECT_EQ(FromOpaque(client.get())->s3->write_record_size_limit, 1024);
+
+  // Retrying the write finishes the pending 0-RTT record although it exceeds
+  // the limit now in effect, then writes the rest under that limit.
+  int written = -1;
+  for (int i = 0; i < 64; i++) {
+    written = SSL_write(client.get(), data.data(), data.size());
+    if (written > 0) {
+      break;
+    }
+    ASSERT_EQ(SSL_ERROR_WANT_WRITE, SSL_get_error(client.get(), written));
+    ASSERT_TRUE(drain_server());
+  }
+  ASSERT_EQ(written, static_cast<int>(data.size()));
+  ASSERT_TRUE(drain_server());
+  EXPECT_EQ(Bytes(received), Bytes(data));
+}
