+TEST(SSLTest, RecordSizeLimitServerRejectsLargeEarlyData) {
+  bssl::UniquePtr<SSL_CTX> client_ctx(SSL_CTX_new(TLS_method()));
+  bssl::UniquePtr<SSL_CTX> server_ctx =
+      CreateContextWithTestCertificate(TLS_method());
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  ConfigureRecordSizeLimitEarlyData(client_ctx.get(), server_ctx.get());
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(client_ctx.get(), 16385));
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(server_ctx.get(), 16385));
+
+  bssl::UniquePtr<SSL_SESSION> session =
+      CreateClientSession(client_ctx.get(), server_ctx.get());
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_early_data_capable(session.get()));
+
+  // The server now advertises a limit below the size of the 0-RTT record.
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(server_ctx.get(), 512));
+  bssl::UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx.get(),
+                                    server_ctx.get()));
+  SSL_set_session(client.get(), session.get());
+  ASSERT_EQ(1, SSL_do_handshake(client.get()));
+  ASSERT_TRUE(SSL_in_early_data(client.get()));
+  std::vector<uint8_t> early(2000, 'E');
+  ASSERT_EQ(static_cast<int>(early.size()),
+            SSL_write(client.get(), early.data(), early.size()));
+
+  // The server declines 0-RTT and skips the oversized early record without a
+  // record_overflow alert.
+  ASSERT_EQ(-1, SSL_do_handshake(server.get()));
+  ASSERT_EQ(SSL_ERROR_WANT_READ, SSL_get_error(server.get(), -1));
+  EXPECT_EQ(SSL_get_early_data_reason(server.get()), ssl_early_data_disabled);
+  ASSERT_EQ(-1, SSL_do_handshake(client.get()));
+  ASSERT_EQ(SSL_ERROR_EARLY_DATA_REJECTED, SSL_get_error(client.get(), -1));
+  SSL_reset_early_data_reject(client.get());
+  ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+  EXPECT_TRUE(SSL_session_reused(client.get()));
+  EXPECT_FALSE(SSL_early_data_accepted(client.get()));
+  EXPECT_FALSE(SSL_early_data_accepted(server.get()));
+  EXPECT_EQ(FromOpaque(client.get())->s3->write_record_size_limit, 512);
+  EXPECT_EQ(FromOpaque(server.get())->s3->read_record_size_limit, 512);
+
+  // The resent data follows the negotiated limit.
+  const uint64_t sequence_before = FromOpaque(client.get())->s3->write_sequence;
+  ASSERT_EQ(static_cast<int>(early.size()),
+            SSL_write(client.get(), early.data(), early.size()));
+  EXPECT_EQ(FromOpaque(client.get())->s3->write_sequence - sequence_before, 4u);
+  std::vector<uint8_t> received(early.size());
+  ASSERT_TRUE(ReadFully(server.get(), Span(received)));
+  EXPECT_EQ(Bytes(received), Bytes(early));
+}
