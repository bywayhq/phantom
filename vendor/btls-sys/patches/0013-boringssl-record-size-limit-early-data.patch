diff --git a/ssl/s3_pkt.cc b/ssl/s3_pkt.cc
index dbcb72717..ed9cc6e33 100644
--- a/ssl/s3_pkt.cc
+++ b/ssl/s3_pkt.cc
@@ -80,7 +80,14 @@ int tls_write_app_data(SSLImpl *ssl, bool *out_needs_handshake,
                                     hs->early_data_written});
     }
 
-    const size_t to_write = std::min(max_send_fragment, in.size());
+    size_t to_write = std::min(max_send_fragment, in.size());
+    // A pending record was sealed under the limit of an earlier attempt, such
+    // as a 0-RTT record retried after the handshake installs RFC 8449 limits.
+    // Finish writing it rather than failing the retry.
+    if (!ssl->s3->pending_write.empty()) {
