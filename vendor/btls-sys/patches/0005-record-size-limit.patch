diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index b5c5993e7..034d7d6ff 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5600,6 +5600,21 @@ OPENSSL_EXPORT void SSL_set_permute_extensions(SSL *ssl, int enabled);
 OPENSSL_EXPORT int SSL_CTX_set_extension_order(SSL_CTX *ctx,
                                                const uint16_t *ids, int num);
 
+// SSL_set_record_size_limit configures the maximum protected TLS record
+// plaintext |ssl| is willing to receive, as specified by RFC 8449. |limit|
+// must be zero (to disable the extension) or between 64 and 16385 inclusive.
+// It returns one on success and zero if |limit| is invalid, the handshake
+// configuration has been shed, or |ssl| uses DTLS, QUIC, or handoff.
+OPENSSL_EXPORT int SSL_set_record_size_limit(SSL *ssl, uint16_t limit);
+
+// SSL_CTX_set_record_size_limit configures the default RFC 8449 receive limit
+// for new TLS connections from |ctx|. |limit| has the same range as
+// SSL_set_record_size_limit. DTLS contexts reject non-zero limits. QUIC rejects
+// conflicting configuration when either option is set. Handoff rejects the
+// limit when it is set after handoff mode and otherwise rejects the connection
+// when the handshake begins.
+OPENSSL_EXPORT int SSL_CTX_set_record_size_limit(SSL_CTX *ctx, uint16_t limit);
+
 // SSL_max_seal_overhead returns the maximum overhead, in bytes, of sealing a
 // record with `ssl`.
 OPENSSL_EXPORT size_t SSL_max_seal_overhead(const SSL *ssl);
diff --git a/include/openssl/tls1.h b/include/openssl/tls1.h
index 0a01b2456..49ccf29c2 100644
--- a/include/openssl/tls1.h
+++ b/include/openssl/tls1.h
@@ -48,6 +48,9 @@ extern "C" {
 #define TLS1_AD_NO_APPLICATION_PROTOCOL 120
 #define TLS1_AD_ECH_REQUIRED 121
 
+// ExtensionType value from RFC 8449.
+#define TLSEXT_TYPE_record_size_limit 28
+
 // ExtensionType values from RFC 6066
 #define TLSEXT_TYPE_server_name 0
 #define TLSEXT_TYPE_status_request 5
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index 9ad7527ec..577b2d840 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -3876,6 +3876,134 @@ bool ssl_negotiate_alps(SSL_HANDSHAKE *hs, uint8_t *out_alert,
   return true;
 }
 
+// RFC 8449 expresses the TLS 1.3 limit over TLSInnerPlaintext, including the
+// content type and padding. Earlier versions cap TLSPlaintext at 2^14 bytes.
+static uint16_t record_size_limit_for_version(const SSLImpl *ssl,
+                                              uint16_t limit) {
+  const uint16_t protocol_limit =
+      ssl_protocol_version(ssl) >= TLS1_3_VERSION
+          ? SSL3_RT_MAX_PLAIN_LENGTH + 1
+          : SSL3_RT_MAX_PLAIN_LENGTH;
+  return std::min(limit, protocol_limit);
+}
+
+static bool record_size_limit_add_clienthello(
+    const SSL_HANDSHAKE *hs, CBB *out, CBB *, ssl_client_hello_type_t) {
+  if (hs->record_size_limit == 0 || SSL_is_dtls(hs->ssl) ||
+      SSL_is_quic(hs->ssl)) {
+    return true;
+  }
+
+  CBB contents;
+  return CBB_add_u16(out, TLSEXT_TYPE_record_size_limit) &&
+         CBB_add_u16_length_prefixed(out, &contents) &&
+         CBB_add_u16(&contents, hs->record_size_limit) && CBB_flush(out);
+}
+
+static bool record_size_limit_parse_serverhello(SSL_HANDSHAKE *hs,
+                                                uint8_t *out_alert,
+                                                CBS *contents) {
+  if (contents == nullptr) {
+    hs->record_size_limit_negotiated = false;
+    hs->peer_record_size_limit = 0;
+    hs->record_size_limit_exceeded = false;
+    return true;
+  }
+
+  uint16_t peer_limit;
+  const uint16_t protocol_limit =
+      ssl_protocol_version(hs->ssl) >= TLS1_3_VERSION
+          ? SSL3_RT_MAX_PLAIN_LENGTH + 1
+          : SSL3_RT_MAX_PLAIN_LENGTH;
+  if (!CBS_get_u16(contents, &peer_limit) || CBS_len(contents) != 0) {
+    *out_alert = SSL_AD_DECODE_ERROR;
+    return false;
+  }
+  if (peer_limit < 64 || peer_limit > protocol_limit) {
+    *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+    return false;
+  }
+
+  hs->peer_record_size_limit = peer_limit;
+  hs->record_size_limit =
+      record_size_limit_for_version(hs->ssl, hs->record_size_limit);
+  hs->record_size_limit_negotiated = true;
+  if (hs->record_size_limit_exceeded) {
+    *out_alert = SSL_AD_RECORD_OVERFLOW;
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DATA_LENGTH_TOO_LONG);
+    return false;
+  }
+  if (ssl_protocol_version(hs->ssl) >= TLS1_3_VERSION) {
+    // EncryptedExtensions is parsed under the handshake read key. Apply the
+    // negotiated limits to that epoch immediately after parsing it.
+    hs->ssl->s3->read_record_size_limit = hs->record_size_limit;
+    hs->ssl->s3->write_record_size_limit = peer_limit;
+  }
+  return true;
+}
+
+static bool record_size_limit_parse_clienthello(SSL_HANDSHAKE *hs,
+                                                uint8_t *out_alert,
+                                                CBS *contents) {
+  if (hs->ssl->s3->used_hello_retry_request) {
+    uint16_t second_limit;
+    if (contents == nullptr || !CBS_get_u16(contents, &second_limit) ||
+        CBS_len(contents) != 0 || second_limit != hs->peer_record_size_limit) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+      return false;
+    }
+    return true;
+  }
+
+  hs->record_size_limit_negotiated = false;
+  hs->peer_record_size_limit = 0;
+  if (contents == nullptr) {
+    return true;
+  }
+
+  uint16_t peer_limit;
+  if (!CBS_get_u16(contents, &peer_limit) || CBS_len(contents) != 0) {
+    *out_alert = SSL_AD_DECODE_ERROR;
+    return false;
+  }
+  if (peer_limit < 64) {
+    *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+    return false;
+  }
+
+  hs->peer_record_size_limit = peer_limit;
+  hs->record_size_limit =
+      record_size_limit_for_version(hs->ssl, hs->record_size_limit);
+  hs->record_size_limit_negotiated = hs->record_size_limit != 0;
+  return true;
+}
+
+static bool record_size_limit_add_serverhello(SSL_HANDSHAKE *hs, CBB *out) {
+  if (!hs->record_size_limit_negotiated) {
+    return true;
+  }
+
+  const uint16_t peer_limit =
+      record_size_limit_for_version(hs->ssl, hs->peer_record_size_limit);
+  CBB contents;
+  if (!CBB_add_u16(out, TLSEXT_TYPE_record_size_limit) ||
+      !CBB_add_u16_length_prefixed(out, &contents) ||
+      !CBB_add_u16(&contents, hs->record_size_limit) || !CBB_flush(out)) {
+    return false;
+  }
+
+  if (ssl_protocol_version(hs->ssl) >= TLS1_3_VERSION) {
+    // The TLS 1.3 handshake write key is installed before
+    // EncryptedExtensions is constructed.
+    hs->ssl->s3->read_record_size_limit = hs->record_size_limit;
+    hs->ssl->s3->write_record_size_limit = peer_limit;
+  }
+  return true;
+}
+
