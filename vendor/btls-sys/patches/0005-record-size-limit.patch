+static void ConfigureVersion(SSL_CTX *ctx, uint16_t version) {
+  ASSERT_TRUE(SSL_CTX_set_min_proto_version(ctx, version));
+  ASSERT_TRUE(SSL_CTX_set_max_proto_version(ctx, version));
+}
+
+struct RecordSizeLimitCallbackState {
+  bool make_first_protected_flight_oversized = false;
+  bool peer_limit_changed = false;
+  // The first entry is the TLS 1.3 record containing EncryptedExtensions.
+  std::vector<uint16_t> protected_record_lengths;
+};
+
+static void RecordSizeLimitMsgCallback(int is_write, int /*cb_version*/,
+                                       int cb_type, const void *buf, size_t len,
+                                       SSL *ssl, void *arg) {
+  if (!is_write) {
+    return;
+  }
+
+  auto *state = static_cast<RecordSizeLimitCallbackState *>(arg);
+  const auto bytes = Span(static_cast<const uint8_t *>(buf), len);
+  if (state->make_first_protected_flight_oversized &&
+      cb_type == SSL3_RT_HANDSHAKE && !bytes.empty() &&
+      bytes[0] == SSL3_MT_SERVER_HELLO) {
+    // The ServerHello callback runs after ClientHello parsing and before the
+    // handshake write key is installed. Ignore the client's limit while still
+    // sending record_size_limit in EncryptedExtensions.
+    FromOpaque(ssl)->s3->hs->peer_record_size_limit =
+        SSL3_RT_MAX_PLAIN_LENGTH + 1;
+    state->peer_limit_changed = true;
+  }
+
+  if (cb_type == SSL3_RT_HEADER && bytes.size() == SSL3_RT_HEADER_LENGTH &&
+      bytes[0] == SSL3_RT_APPLICATION_DATA) {
+    state->protected_record_lengths.push_back(
+        static_cast<uint16_t>((bytes[3] << 8) | bytes[4]));
+  }
+}
