+TEST(SSLTest, RecordSizeLimitFragmentsProtectedHandshakeAndApplicationData) {
+  bssl::UniquePtr<SSL_CTX> client_ctx(SSL_CTX_new(TLS_method()));
+  bssl::UniquePtr<SSL_CTX> server_ctx =
+      CreateContextWithTestCertificate(TLS_method());
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  ConfigureVersion(client_ctx.get(), TLS1_3_VERSION);
+  ConfigureVersion(server_ctx.get(), TLS1_3_VERSION);
+  SSL_CTX_set_options(server_ctx.get(), SSL_OP_NO_TICKET);
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(client_ctx.get(), 64));
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(server_ctx.get(), 512));
+
+  RecordSizeLimitCallbackState callback_state;
+  SSL_CTX_set_msg_callback(server_ctx.get(), RecordSizeLimitMsgCallback);
+  SSL_CTX_set_msg_callback_arg(server_ctx.get(), &callback_state);
+
+  bssl::UniquePtr<SSL> client, server;
+  ASSERT_TRUE(ConnectClientAndServer(&client, &server, client_ctx.get(),
+                                     server_ctx.get()));
+
+  size_t max_ciphertext_len;
+  ASSERT_TRUE(FromOpaque(server.get())->s3->aead_write_ctx->CiphertextLen(
+      &max_ciphertext_len, 63, 1));
+  ASSERT_GT(callback_state.protected_record_lengths.size(), 1u);
+  for (uint16_t length : callback_state.protected_record_lengths) {
+    EXPECT_LE(length, max_ciphertext_len);
+  }
+
+  const uint64_t sequence_before = FromOpaque(server.get())->s3->write_sequence;
+  uint8_t data[200] = {0};
+  ASSERT_EQ(SSL_write(server.get(), data, sizeof(data)),
+            static_cast<int>(sizeof(data)));
+  EXPECT_EQ(FromOpaque(server.get())->s3->write_sequence - sequence_before, 4u);
+
+  uint8_t received[sizeof(data)];
+  size_t offset = 0;
+  while (offset < sizeof(received)) {
+    int ret = SSL_read(client.get(), received + offset,
+                       static_cast<int>(sizeof(received) - offset));
+    ASSERT_GT(ret, 0);
+    offset += ret;
+  }
+  EXPECT_EQ(OPENSSL_memcmp(data, received, sizeof(data)), 0);
+}
