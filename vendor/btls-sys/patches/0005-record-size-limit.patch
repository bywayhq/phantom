+  // protected-record plaintext limits for the active read and write epochs.
+  // They use the RFC 8449 wire convention: TLS 1.3 includes the inner content
+  // type and padding. Zero means the extension was not negotiated.
+  uint16_t read_record_size_limit = 0;
+  uint16_t write_record_size_limit = 0;
+
   // hs is the handshake state for the current handshake or NULL if there isn't
   // one.
   UniquePtr<SSL_HANDSHAKE> hs;
@@ -3572,6 +3599,10 @@ struct SSL_CONFIG {
   // to negotiate and convey application settings.
