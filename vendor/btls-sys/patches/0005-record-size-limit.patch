+        record_size_limit_parse_serverhello,
+        record_size_limit_parse_clienthello,
+        record_size_limit_add_serverhello,
+    },
     {
         TLSEXT_TYPE_client_cert_type,
         ext_client_cert_type_add_clienthello,
