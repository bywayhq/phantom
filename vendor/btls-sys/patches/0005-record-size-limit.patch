+static bool record_size_limit_is_valid(uint16_t limit) {
+  return limit == 0 || (limit >= 64 && limit <= 16385);
+}
+
+int SSL_set_record_size_limit(SSL *ssl, uint16_t limit) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!record_size_limit_is_valid(limit)) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+    return 0;
+  }
+  if (ssl_impl->config == nullptr ||
+      (limit != 0 &&
+       (SSL_is_dtls(ssl_impl) || SSL_is_quic(ssl_impl) ||
+        ssl_impl->config->handoff))) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  ssl_impl->config->record_size_limit = limit;
+  return 1;
+}
+
+int SSL_CTX_set_record_size_limit(SSL_CTX *ctx, uint16_t limit) {
+  auto *ctx_impl = FromOpaque(ctx);
+  if (!record_size_limit_is_valid(limit)) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+    return 0;
+  }
+  if (limit != 0 &&
+      (ctx_impl->method->is_dtls || ctx_impl->quic_method != nullptr ||
+       ctx_impl->handoff)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  ctx_impl->record_size_limit = limit;
+  return 1;
+}
