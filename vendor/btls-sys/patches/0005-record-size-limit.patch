+TEST(SSLTest, RecordSizeLimitRejectsOversizedFirstProtectedFlight) {
+  bssl::UniquePtr<SSL_CTX> client_ctx(SSL_CTX_new(TLS_method()));
+  bssl::UniquePtr<SSL_CTX> server_ctx =
+      CreateContextWithTestCertificate(TLS_method());
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  ConfigureVersion(client_ctx.get(), TLS1_3_VERSION);
+  ConfigureVersion(server_ctx.get(), TLS1_3_VERSION);
+  SSL_CTX_set_options(server_ctx.get(), SSL_OP_NO_TICKET);
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(client_ctx.get(), 64));
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(server_ctx.get(), 512));
+
+  RecordSizeLimitCallbackState callback_state;
+  callback_state.make_first_protected_flight_oversized = true;
+  SSL_CTX_set_msg_callback(server_ctx.get(), RecordSizeLimitMsgCallback);
+  SSL_CTX_set_msg_callback_arg(server_ctx.get(), &callback_state);
+
+  bssl::UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx.get(),
+                                    server_ctx.get()));
+  int client_ret = 0;
+  int client_err = SSL_ERROR_NONE;
+  for (size_t i = 0; i < 10 && client_err != SSL_ERROR_SSL; i++) {
+    client_ret = SSL_do_handshake(client.get());
+    client_err = SSL_get_error(client.get(), client_ret);
+    ASSERT_TRUE(client_err == SSL_ERROR_NONE ||
+                client_err == SSL_ERROR_WANT_READ ||
+                client_err == SSL_ERROR_WANT_WRITE ||
+                client_err == SSL_ERROR_SSL);
+    if (client_err == SSL_ERROR_SSL) {
+      break;
+    }
+
+    const int server_ret = SSL_do_handshake(server.get());
+    const int server_err = SSL_get_error(server.get(), server_ret);
+    ASSERT_TRUE(server_err == SSL_ERROR_NONE ||
+                server_err == SSL_ERROR_WANT_READ ||
+                server_err == SSL_ERROR_WANT_WRITE);
+  }
+
+  ASSERT_TRUE(callback_state.peer_limit_changed);
+  size_t max_ciphertext_len;
+  ASSERT_TRUE(FromOpaque(server.get())->s3->aead_write_ctx->CiphertextLen(
+      &max_ciphertext_len, 63, 1));
+  ASSERT_FALSE(callback_state.protected_record_lengths.empty());
+  EXPECT_GT(callback_state.protected_record_lengths.front(),
+            max_ciphertext_len);
+  EXPECT_EQ(client_err, SSL_ERROR_SSL);
+  EXPECT_EQ(FromOpaque(client.get())->s3->send_alert[1],
+            SSL_AD_RECORD_OVERFLOW);
+
+  ERR_clear_error();
+  const int server_ret = SSL_do_handshake(server.get());
+  EXPECT_EQ(SSL_get_error(server.get(), server_ret), SSL_ERROR_SSL);
+  EXPECT_EQ(ERR_GET_REASON(ERR_peek_error()),
+            SSL_R_TLSV1_ALERT_RECORD_OVERFLOW);
+}
