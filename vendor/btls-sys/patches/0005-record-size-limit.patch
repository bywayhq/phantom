+  if (hs->max_version < TLS1_3_VERSION &&
+      hs->record_size_limit > SSL3_RT_MAX_PLAIN_LENGTH) {
+    hs->record_size_limit = SSL3_RT_MAX_PLAIN_LENGTH;
+  }
+
   uint8_t ech_enc[EVP_HPKE_MAX_ENC_LENGTH];
   size_t ech_enc_len;
   if (!ssl_select_ech_config(hs, ech_enc, &ech_enc_len)) {
