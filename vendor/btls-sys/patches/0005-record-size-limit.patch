diff --git a/ssl/ssl_test.cc b/ssl/ssl_test.cc
index 7f35da040..4d8f6a6f2 100644
--- a/ssl/ssl_test.cc
+++ b/ssl/ssl_test.cc
@@ -2221,6 +2221,348 @@ static bssl::UniquePtr<SSL_SESSION> CreateClientSession(
