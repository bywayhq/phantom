   if (ctx_impl->method->is_dtls) {
     return 0;
   }
@@ -2795,6 +2837,11 @@ int SSL_CTX_set_quic_method(SSL_CTX *ctx, const SSL_QUIC_METHOD *quic_method) {
 
 int SSL_set_quic_method(SSL *ssl, const SSL_QUIC_METHOD *quic_method) {
