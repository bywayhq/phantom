+// GetGreaseClientHelloBody sets `*out` to the body of the first ClientHello
+// that a new client of `ctx` sends with ECH GREASE, after `configure` runs.
+template <typename Configure>
+static bool GetGreaseClientHelloBody(SSL_CTX *ctx, Configure configure,
+                                     std::vector<uint8_t> *out) {
+  bssl::UniquePtr<SSL> ssl(SSL_new(ctx));
+  if (!ssl || !configure(ssl.get())) {
+    return false;
+  }
+  SSL_set_enable_ech_grease(ssl.get(), 1);
+  SSL_set_connect_state(ssl.get());
+  std::vector<uint8_t> client_hello;
+  if (!GetClientHello(ssl.get(), &client_hello)) {
+    return false;
+  }
+  out->assign(
+      client_hello.begin() + SSL3_RT_HEADER_LENGTH + SSL3_HM_HEADER_LENGTH,
+      client_hello.end());
+  return true;
+}
+
+TEST(SSLTest, ECHGreasePayloadFromClientHello) {
+  const std::string kLongName(120, 'a');
+  for (bool grease : {false, true}) {
+    SCOPED_TRACE(grease);
+    bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    SSL_CTX_set_grease_enabled(ctx.get(), grease);
+    for (const char *name :
+         {"server.phantom.test", static_cast<const char *>(nullptr),
+          kLongName.c_str()}) {
+      SCOPED_TRACE(name == nullptr ? "(none)" : name);
+      for (uint8_t maximum_name_length : {0, 100, 255}) {
+        SCOPED_TRACE(maximum_name_length);
+        std::vector<uint8_t> body;
+        ASSERT_TRUE(GetGreaseClientHelloBody(
+            ctx.get(),
+            [&](SSL *ssl) {
+              return (name == nullptr || SSL_set_tlsext_host_name(ssl, name)) &&
+                     SSL_set_ech_grease_payload_from_client_hello(
+                         ssl, maximum_name_length, nullptr, 0);
+            },
+            &body));
+        bssl::UniquePtr<SSL> parser(SSL_new(ctx.get()));
+        ASSERT_TRUE(parser);
+        const size_t payload_len = GreaseECHPayloadLength(parser.get(), body);
+        EXPECT_EQ(
+            NSSGreaseECHPayloadLength(parser.get(), body, maximum_name_length),
+            payload_len);
+        EXPECT_EQ(0u, (payload_len - 16) % 32);
+      }
+    }
+  }
+
+  // The last call between this and SSL_set_ech_grease_payload_length wins.
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  bssl::UniquePtr<SSL> parser(SSL_new(ctx.get()));
+  ASSERT_TRUE(parser);
+  std::vector<uint8_t> body;
+  ASSERT_TRUE(GetGreaseClientHelloBody(
+      ctx.get(),
+      [](SSL *ssl) {
+        return SSL_set_ech_grease_payload_from_client_hello(ssl, 100, nullptr,
+                                                            0) &&
+               SSL_set_ech_grease_payload_length(ssl, 239);
+      },
+      &body));
+  EXPECT_EQ(239u, GreaseECHPayloadLength(parser.get(), body));
+  ASSERT_TRUE(GetGreaseClientHelloBody(
+      ctx.get(),
+      [](SSL *ssl) {
+        return SSL_set_ech_grease_payload_length(ssl, 239) &&
+               SSL_set_ech_grease_payload_from_client_hello(ssl, 100, nullptr,
+                                                            0) &&
+               SSL_set_tlsext_host_name(ssl, "server.phantom.test");
+      },
+      &body));
+  EXPECT_EQ(NSSGreaseECHPayloadLength(parser.get(), body, 100),
+            GreaseECHPayloadLength(parser.get(), body));
+
+  // DTLS and a shed configuration are rejected.
+  bssl::UniquePtr<SSL_CTX> dtls_ctx(SSL_CTX_new(DTLS_method()));
+  ASSERT_TRUE(dtls_ctx);
+  bssl::UniquePtr<SSL> dtls(SSL_new(dtls_ctx.get()));
+  ASSERT_TRUE(dtls);
+  EXPECT_FALSE(SSL_set_ech_grease_payload_from_client_hello(dtls.get(), 100,
+                                                            nullptr, 0));
+  EXPECT_TRUE(
+      ErrorsAreAndClear({{ERR_LIB_SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED}}));
+  bssl::UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  FromOpaque(ssl.get())->config.reset();
+  EXPECT_FALSE(
+      SSL_set_ech_grease_payload_from_client_hello(ssl.get(), 100, nullptr, 0));
+  EXPECT_TRUE(
+      ErrorsAreAndClear({{ERR_LIB_SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED}}));
+}
