diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index 678df4be7..7b0c7a553 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -4699,10 +4699,43 @@ OPENSSL_EXPORT void SSL_set_enable_ech_grease(SSL *ssl, int enable);
 // SSL_set_ech_grease_payload_length configures the exact payload length of a
 // GREASE ECH extension. This does not enable ECH GREASE. The configured
 // payload must be non-empty and, together with the ECHClientHelloOuter framing,
-// must fit in a TLS extension body. It returns one on success and zero on error.
+// must fit in a TLS extension body. It replaces a configuration from
+// |SSL_set_ech_grease_payload_from_client_hello|. It returns one on success and
+// zero on error.
 OPENSSL_EXPORT int SSL_set_ech_grease_payload_length(SSL *ssl,
                                                      size_t payload_length);
 
+// SSL_set_ech_grease_payload_from_client_hello configures |ssl| to size the
+// payload of a GREASE ECH extension from the ClientHello that carries it, as
+// NSS does. The payload is as long as the encrypted EncodedClientHelloInner a
+// real ECH offer of that ClientHello would carry, padded as in RFC 9849,
+// section 6.1.3, for an ECHConfig whose maximum_name_length is
+// |maximum_name_length|. NSS's default is 100. Firefox keeps it over QUIC and
+// applies its security.tls.ech.grease_size preference, also 100, over TCP.
+//
+// NSS pads by the length of the host it connects to, which is also its
+// server_name unless the host is an IP literal, for which it sends no
+// server_name. |host| and |host_len| give that host as the URL names it, with
+// an IPv6 literal written without brackets, such as "127.0.0.1" or "::1".
+// Only its length is used. If |host| is NULL, the server_name host name is
+// used, and without server_name, all of |maximum_name_length| is padding.
+//
+// The EncodedClientHelloInner follows NSS 3.128. It copies server_name and
+// pre_shared_key in full, offers only TLS 1.3 and any GREASE version in
+// supported_versions, omits ec_point_formats, extended_master_secret,
+// session_ticket, and renegotiation_info, and compresses every other
+// extension into ech_outer_extensions. The length therefore depends on the
+// ClientHello, including any session ticket, so it can change between
+// connections. The second ClientHello after a HelloRetryRequest repeats the
+// first one's extension.
+//
+// This does not enable ECH GREASE. It replaces a length set by
+// |SSL_set_ech_grease_payload_length|. It returns one on success and zero if
+// |host| is NULL with a non-zero |host_len|, or if |ssl| uses DTLS or its
+// handshake configuration has been shed.
+OPENSSL_EXPORT int SSL_set_ech_grease_payload_from_client_hello(
+    SSL *ssl, uint8_t maximum_name_length, const char *host, size_t host_len);
+
 // SSL_set1_ech_grease_aeads configures the HPKE AEAD identifiers from which a
 // GREASE ECH extension selects its cipher suite. Each handshake selects one
 // entry uniformly at random, and a HelloRetryRequest reuses that selection.
diff --git a/ssl/encrypted_client_hello.cc b/ssl/encrypted_client_hello.cc
index 371b3d33c..cf5271f57 100644
--- a/ssl/encrypted_client_hello.cc
+++ b/ssl/encrypted_client_hello.cc
@@ -763,6 +763,134 @@ static size_t random_index(size_t n) {
   return value % n;
 }
 
+// NSS sizes a GREASE ECH payload from the ClientHello it is sent in.
+// tls13_MaybeGreaseEch runs after every other extension, including
+// pre_shared_key with placeholder binders, is built, and before padding. It
+// builds the EncodedClientHelloInner that a real ECH offer would encrypt
+// (tls13_ConstructInnerExtensionsFromOuter with compression and
+// tls13_EncodeClientHelloInner), pads it with tls13_PadChInner, and adds a
+// 16-byte AEAD tag. The functions below follow NSS 3.128, which Firefox 156
+// and 157 ship, with Firefox's defaults: enableEchXtnCompression on and
+// callExtensionWriterOnEchInner off.
+
+// nss_omits_from_client_hello_inner returns whether NSS supports `type` but
+// does not know it in TLS 1.3, so it leaves it out of ClientHelloInner
+// (ssl_supported_extensions in ssl3ext.c against KnownExtensions in
+// tls13con.c).
+static bool nss_omits_from_client_hello_inner(uint16_t type) {
+  switch (type) {
+    case TLSEXT_TYPE_ec_point_formats:
+    case TLSEXT_TYPE_extended_master_secret:
+    case TLSEXT_TYPE_session_ticket:
+    case 46:  // ticket_early_data_info, from a TLS 1.3 draft.
+    case TLSEXT_TYPE_renegotiate:
+      return true;
+  }
+  return false;
+}
+
+static bool is_grease_value(uint16_t value) {
+  return (value & 0x0f0f) == 0x0a0a;
+}
+
+bool ssl_ech_grease_payload_len_from_client_hello(
+    Span<const uint8_t> client_hello, uint8_t maximum_name_length,
+    std::optional<size_t> host_len, size_t aead_overhead, size_t *out_len) {
+  CBS cbs(client_hello), session_id, cipher_suites, compression_methods,
+      extensions;
+  uint16_t legacy_version;
+  if (!CBS_get_u16(&cbs, &legacy_version) ||
+      !CBS_skip(&cbs, SSL3_RANDOM_SIZE) ||
+      !CBS_get_u8_length_prefixed(&cbs, &session_id) ||
+      !CBS_get_u16_length_prefixed(&cbs, &cipher_suites) ||
+      !CBS_get_u8_length_prefixed(&cbs, &compression_methods) ||
+      !CBS_get_u16_length_prefixed(&cbs, &extensions) || CBS_len(&cbs) != 0) {
+    return false;
+  }
+
+  // legacy_version, random, an empty legacy_session_id, the outer
+  // cipher_suites and legacy_compression_methods, and the extensions length.
+  size_t len = 2 + SSL3_RANDOM_SIZE + 1 + 2 + CBS_len(&cipher_suites) + 1 +
+               CBS_len(&compression_methods) + 2;
+  // The inner encrypted_client_hello extension.
+  len += 4 + 1;
+  size_t num_compressed = 0, name_len = 0;
+  while (CBS_len(&extensions) != 0) {
+    uint16_t type;
+    CBS body;
+    if (!CBS_get_u16(&extensions, &type) ||
+        !CBS_get_u16_length_prefixed(&extensions, &body)) {
+      return false;
+    }
+    switch (type) {
+      case TLSEXT_TYPE_encrypted_client_hello:
+      case TLSEXT_TYPE_padding:
+        // NSS sizes the payload before it adds either extension.
+        break;
+
+      case TLSEXT_TYPE_server_name: {
+        // ClientHelloInner carries the server name in full.
+        CBS copy = body, server_name_list, host_name;
+        uint8_t name_type;
+        if (!CBS_get_u16_length_prefixed(&copy, &server_name_list) ||
+            !CBS_get_u8(&server_name_list, &name_type) ||
+            !CBS_get_u16_length_prefixed(&server_name_list, &host_name)) {
+          return false;
+        }
+        name_len = CBS_len(&host_name);
+        len += 4 + CBS_len(&body);
+        break;
+      }
+
+      case TLSEXT_TYPE_supported_versions: {
+        // ClientHelloInner offers TLS 1.3, and a GREASE version if NSS
+        // GREASEs, which puts a GREASE version in the outer list.
+        CBS versions;
+        if (!CBS_get_u8_length_prefixed(&body, &versions)) {
+          return false;
+        }
+        bool grease = false;
+        while (CBS_len(&versions) != 0) {
+          uint16_t version;
+          if (!CBS_get_u16(&versions, &version)) {
+            return false;
+          }
+          grease = grease || is_grease_value(version);
+        }
+        len += 4 + 1 + 2 + (grease ? 2 : 0);
+        break;
+      }
+
+      case TLSEXT_TYPE_pre_shared_key:
+        // A GREASE payload copies pre_shared_key in full.
+        len += 4 + CBS_len(&body);
+        break;
+
+      default:
+        if (!nss_omits_from_client_hello_inner(type)) {
+          num_compressed++;
+        }
+        break;
+    }
+  }
+  if (num_compressed != 0) {
+    // ech_outer_extensions lists each compressed extension's type.
+    len += 4 + 1 + 2 * num_compressed;
+  }
+
+  // Pad as RFC 9849, section 6.1.3 describes, by the host length NSS takes
+  // from its URL (strlen(ss->url)). NSS omits server_name for an IP literal but
+  // still pads by its text, so `host_len` takes precedence.
+  if (host_len) {
+    name_len = *host_len;
+  }
+  size_t padding =
+      name_len < maximum_name_length ? maximum_name_length - name_len : 0;
+  padding += 31 - ((len + padding - 1) % 32);
+  *out_len = len + padding + aead_overhead;
+  return true;
+}
+
 static bool setup_ech_grease(SSL_HANDSHAKE *hs) {
   assert(!hs->selected_ech_config);
   if (hs->max_version < TLS1_3_VERSION || !hs->config->ech_grease_enabled) {
@@ -806,10 +934,31 @@ static bool setup_ech_grease(SSL_HANDSHAKE *hs) {
   // The server_name extension has an overhead of 9 bytes. For now, arbitrarily
   // estimate maximum_name_length to be between 32 and 100 bytes. Then round up
   // to a multiple of 32, to match RFC 9849, section 6.1.3.
-  const size_t payload_len = hs->config->ech_grease_payload_length
-                                 ? *hs->config->ech_grease_payload_length
-                                 : 32 * random_size(128 / 32, 224 / 32) +
-                                       aead_overhead(aead);
+  size_t payload_len;
+  if (hs->config->ech_grease_payload_length) {
+    payload_len = *hs->config->ech_grease_payload_length;
+  } else if (hs->config->ech_grease_maximum_name_length) {
+    // Every ClientHello input is known here: PSKs, key shares, the extension
+    // order, and whether early data is offered. A HelloRetryRequest reuses
+    // `hs->ech_client_outer`, so this runs once per handshake.
+    bssl::ScopedCBB client_hello;
+    if (!CBB_init(client_hello.get(), 512) ||
+        !ssl_write_client_hello_for_ech_grease(hs, client_hello.get()) ||
+        !ssl_ech_grease_payload_len_from_client_hello(
+            Span(CBB_data(client_hello.get()), CBB_len(client_hello.get())),
+            *hs->config->ech_grease_maximum_name_length,
+            hs->config->ech_grease_host_len, aead_overhead(aead),
+            &payload_len)) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+      return false;
+    }
+    if (payload_len > UINT16_MAX - kEchGreaseExtensionOverhead) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_OVERFLOW);
+      return false;
+    }
+  } else {
+    payload_len = 32 * random_size(128 / 32, 224 / 32) + aead_overhead(aead);
+  }
   bssl::ScopedCBB cbb;
   CBB enc_cbb, payload_cbb;
   uint8_t *payload;
@@ -961,6 +1110,31 @@ int SSL_set_ech_grease_payload_length(SSL *ssl, size_t payload_length) {
   }
   ssl_impl->config->ech_grease_payload_length =
       static_cast<uint16_t>(payload_length);
+  ssl_impl->config->ech_grease_maximum_name_length.reset();
+  ssl_impl->config->ech_grease_host_len.reset();
+  return 1;
+}
+
+int SSL_set_ech_grease_payload_from_client_hello(SSL *ssl,
+                                                 uint8_t maximum_name_length,
+                                                 const char *host,
+                                                 size_t host_len) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config || SSL_is_dtls(ssl_impl)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  if (host == nullptr && host_len != 0) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_PASSED_NULL_PARAMETER);
+    return 0;
+  }
+  ssl_impl->config->ech_grease_maximum_name_length = maximum_name_length;
+  if (host != nullptr) {
+    ssl_impl->config->ech_grease_host_len = host_len;
+  } else {
+    ssl_impl->config->ech_grease_host_len.reset();
+  }
+  ssl_impl->config->ech_grease_payload_length.reset();
   return 1;
 }
 
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index 623d182bd..7c011b520 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -4838,6 +4838,54 @@ static bool ssl_add_clienthello_tlsext_inner(SSL_HANDSHAKE *hs, CBB *out,
   return true;
 }
 
+bool ssl_write_client_hello_for_ech_grease(const SSL_HANDSHAKE *hs, CBB *out) {
+  const SSLImpl *const ssl = hs->ssl;
+  // `psk` stays linked to `extensions` until `out` is flushed, so it must live
+  // as long as `extensions`.
+  CBB extensions, psk;
+  if (!ssl_write_client_hello_without_extensions(
+          hs, out, ssl_client_hello_unencrypted, /*empty_session_id=*/false) ||
+      !CBB_add_u16_length_prefixed(out, &extensions)) {
+    return false;
+  }
+
+  // The GREASE ECH payload length only depends on which extensions are sent
+  // and on their lengths, so this ignores `hs->extension_permutation`.
+  // `hs->ech_client_outer` is still empty, so encrypted_client_hello writes
+  // nothing.
+  if (ssl->ctx->grease_enabled &&
+      !add_padding_extension(
+          &extensions, ssl_get_grease_value(hs, ssl_grease_extension1), 0)) {
+    return false;
+  }
+  for (size_t i = 0; i < kNumExtensions; i++) {
+    if (!kExtensions[i].add_clienthello(hs, &extensions, &extensions,
+                                        ssl_client_hello_unencrypted)) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_ERROR_ADDING_EXTENSION);
+      ERR_add_error_dataf("extension %u", (unsigned)kExtensions[i].value);
+      return false;
+    }
+  }
+  if (ssl->ctx->grease_enabled &&
+      !add_padding_extension(
+          &extensions, ssl_get_grease_value(hs, ssl_grease_extension2), 1)) {
+    return false;
+  }
+
+  // Writing pre_shared_key would compute binders over this ClientHello. Only
+  // its length matters here, and that does not depend on the binders.
+  size_t psk_len =
+      ext_pre_shared_key_clienthello_length(hs, ssl_client_hello_unencrypted);
+  if (psk_len != 0) {
+    if (!CBB_add_u16(&extensions, TLSEXT_TYPE_pre_shared_key) ||
+        !CBB_add_u16_length_prefixed(&extensions, &psk) ||
+        !CBB_add_zeros(&psk, psk_len - 4)) {
+      return false;
+    }
+  }
+  return CBB_flush(out);
+}
+
 bool ssl_add_clienthello_tlsext(SSL_HANDSHAKE *hs, CBB *out, CBB *out_encoded,
                                 ssl_client_hello_type_t type) {
   // `out` must contain the start of a ClientHello, which means it must begin
diff --git a/ssl/internal.h b/ssl/internal.h
index ad058d38c..90d67319b 100644
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -2298,6 +2298,31 @@ bool tls13_process_new_session_ticket(SSLImpl *ssl, const SSLMessage &msg);
 UniquePtr<SSL_SESSION> tls13_create_session_with_ticket(SSLImpl *ssl,
                                                         CBS *body);
 
+// ssl_write_client_hello_for_ech_grease writes to `out` the body of the
+// unencrypted ClientHello that `hs` is about to send, as it stands before its
+// ECH GREASE extension is chosen: the encrypted_client_hello extension and
+// padding are absent, and pre_shared_key, if offered, has its final length but
+// zero contents. Extensions are written in the default order. It returns true
+// on success and false on error.
+//
+// The extension callbacks write no handshake state, except that the
+// delegated_credentials callback sets `hs->delegated_credential_sent`. The
+// ClientHello that follows sets the same flag under the same conditions.
+bool ssl_write_client_hello_for_ech_grease(const SSL_HANDSHAKE *hs, CBB *out);
+
+// ssl_ech_grease_payload_len_from_client_hello sets `*out_len` to the payload
+// length NSS 3.128 gives a GREASE encrypted_client_hello extension added to
+// `client_hello`, a ClientHello body from legacy_version through the
+// extensions, for a maximum name length of `maximum_name_length` and an AEAD
+// that adds `aead_overhead` bytes. NSS pads by the length of the host it
+// connects to, `host_len`. If `host_len` is absent, it is the length of the
+// host name in server_name, or zero without server_name. Any
+// encrypted_client_hello and padding extensions in `client_hello` are ignored.
+// It returns true on success and false if `client_hello` does not parse.
+OPENSSL_EXPORT bool ssl_ech_grease_payload_len_from_client_hello(
+    Span<const uint8_t> client_hello, uint8_t maximum_name_length,
+    std::optional<size_t> host_len, size_t aead_overhead, size_t *out_len);
+
 // ssl_setup_extension_order builds the configured extension prefix, the
 // remaining extensions, and the configured tail. The remaining extensions are
 // shuffled when a prefix is configured or permutation is enabled. With no
@@ -3592,6 +3617,17 @@ struct SSL_CONFIG {
   // is selected using BoringSSL's default randomized policy.
   std::optional<uint16_t> ech_grease_payload_length;
 
+  // ech_grease_maximum_name_length, if present, makes a GREASE
+  // ECHClientHelloOuter size its payload from the ClientHello, as NSS does,
+  // with this maximum name length. At most one of it and
+  // `ech_grease_payload_length` is present.
+  std::optional<uint8_t> ech_grease_maximum_name_length;
+
+  // ech_grease_host_len, if present, is the length of the host that
+  // `ech_grease_maximum_name_length` pads against. Otherwise the server_name
+  // host name is used.
+  std::optional<size_t> ech_grease_host_len;
+
   // ech_grease_aeads, if non-empty, contains the distinct HPKE AEAD identifiers
   // from which a GREASE ECHClientHelloOuter selects its cipher suite. Otherwise
   // the AEAD is selected from the AES hardware policy.
diff --git a/ssl/ssl_test.cc b/ssl/ssl_test.cc
index 782c17437..8bd65e2b3 100644
--- a/ssl/ssl_test.cc
+++ b/ssl/ssl_test.cc
@@ -3904,6 +3904,542 @@ TEST(SSLTest, ECHGreaseAEADSurvivesHelloRetryRequest) {
   EXPECT_EQ(seen, std::set<uint16_t>(std::begin(kAEADs), std::end(kAEADs)));
 }
 
+// NSSGreaseECHPayloadLength is a model of NSS's GREASE ECH payload length,
+// written independently of `ssl_ech_grease_payload_len_from_client_hello`.
+// `body` is a ClientHello body, from legacy_version through the extensions,
+// that may already carry the GREASE extension and padding. NSS pads by the
+// length of its URL host, `host_len`, or the server_name host name if absent.
+static size_t NSSGreaseECHPayloadLength(
+    SSL *ssl, Span<const uint8_t> body, size_t maximum_name_length,
+    std::optional<size_t> host_len = std::nullopt) {
+  SSL_CLIENT_HELLO parsed;
+  if (!SSL_parse_client_hello(ssl, &parsed, body.data(), body.size())) {
+    ADD_FAILURE() << "Could not parse ClientHello";
+    return 0;
+  }
+  // EncodedClientHelloInner: version and random, an empty session ID, the
+  // outer cipher suites and compression methods, the extensions length, and
+  // the inner encrypted_client_hello extension.
+  size_t len = 2 + 32 + 1 + 2 + parsed.cipher_suites_len + 1 +
+               parsed.compression_methods_len + 2 + 5;
+  size_t compressed = 0, name_len = 0;
+  CBS extensions(Span(parsed.extensions, parsed.extensions_len));
+  while (CBS_len(&extensions) != 0) {
+    uint16_t type;
+    CBS ext_body;
+    if (!CBS_get_u16(&extensions, &type) ||
+        !CBS_get_u16_length_prefixed(&extensions, &ext_body)) {
+      ADD_FAILURE() << "Could not parse ClientHello extensions";
+      return 0;
+    }
+    const size_t ext_len = CBS_len(&ext_body);
+    if (type == TLSEXT_TYPE_encrypted_client_hello ||
+        type == TLSEXT_TYPE_padding ||
+        // NSS drops these TLS 1.2 extensions from ClientHelloInner.
+        type == TLSEXT_TYPE_ec_point_formats ||
+        type == TLSEXT_TYPE_extended_master_secret ||
+        type == TLSEXT_TYPE_session_ticket || type == TLSEXT_TYPE_renegotiate) {
+      continue;
+    }
+    if (type == TLSEXT_TYPE_server_name) {
+      // list length (2), name type (1), name length (2), then the name.
+      len += 4 + ext_len;
+      name_len = ext_len - 5;
+    } else if (type == TLSEXT_TYPE_supported_versions) {
+      bool grease = false;
+      for (size_t i = 1; i + 1 < ext_len; i += 2) {
+        uint16_t version =
+            (CBS_data(&ext_body)[i] << 8) | CBS_data(&ext_body)[i + 1];
+        grease = grease || (version & 0x0f0f) == 0x0a0a;
+      }
+      len += 4 + 1 + 2 + (grease ? 2 : 0);
+    } else if (type == TLSEXT_TYPE_pre_shared_key) {
+      len += 4 + ext_len;
+    } else {
+      compressed++;
+    }
+  }
+  if (compressed > 0) {
+    len += 4 + 1 + 2 * compressed;
+  }
+  if (host_len) {
+    name_len = *host_len;
+  }
+  len += name_len < maximum_name_length ? maximum_name_length - name_len : 0;
+  len = (len + 31) / 32 * 32;
+  return len + 16;  // AES-GCM and ChaCha20-Poly1305 tags
+}
+
+// GreaseECHPayloadLength returns the payload length of the GREASE
+// encrypted_client_hello extension in ClientHello body `body`, or zero if it
+// has none.
+static size_t GreaseECHPayloadLength(SSL *ssl, Span<const uint8_t> body) {
+  SSL_CLIENT_HELLO parsed;
+  const uint8_t *ech;
+  size_t ech_len;
+  if (!SSL_parse_client_hello(ssl, &parsed, body.data(), body.size()) ||
+      !SSL_early_callback_ctx_extension_get(
+          &parsed, TLSEXT_TYPE_encrypted_client_hello, &ech, &ech_len)) {
+    return 0;
+  }
+  // ECHClientHelloType, cipher suite, config_id, the length-prefixed X25519
+  // enc, and the payload's length prefix.
+  constexpr size_t kECHGreaseOverhead = 1 + 4 + 1 + 2 + 32 + 2;
+  return ech_len < kECHGreaseOverhead ? 0 : ech_len - kECHGreaseOverhead;
+}
+
+// RecordClientHelloBody saves the ClientHello body the server reads in the
+// vector pointed to by the server context's app data.
+static ssl_select_cert_result_t RecordClientHelloBody(
+    const SSL_CLIENT_HELLO *client_hello) {
+  auto *out = static_cast<std::vector<std::vector<uint8_t>> *>(
+      SSL_CTX_get_app_data(SSL_get_SSL_CTX(client_hello->ssl)));
+  out->emplace_back(
+      client_hello->client_hello,
+      client_hello->client_hello + client_hello->client_hello_len);
+  return ssl_select_cert_success;
+}
+
+struct ClientHelloShape {
+  size_t session_id_len;
+  const char *cipher_suites_hex;
+  // Space-separated "type:length" pairs, with the type in hexadecimal.
+  const char *extensions;
+};
+
+// MakeClientHelloBody returns a ClientHello body with the given session ID
+// length, cipher suites, and extension types and body lengths, for the server
+// name "server.phantom.test". Other extension bodies are zero.
+static std::vector<uint8_t> MakeClientHelloBody(const ClientHelloShape &shape) {
+  static const char kServerName[] = "server.phantom.test";
+  std::vector<uint8_t> cipher_suites;
+  EXPECT_TRUE(DecodeHex(&cipher_suites, shape.cipher_suites_hex));
+  std::vector<std::pair<uint16_t, size_t>> shape_extensions;
+  for (const char *p = shape.extensions; *p != '\0';) {
+    char *end;
+    unsigned long type = strtoul(p, &end, 16);
+    EXPECT_EQ(':', *end);
+    size_t len = strtoul(end + 1, &end, 10);
+    shape_extensions.emplace_back(static_cast<uint16_t>(type), len);
+    p = *end == ' ' ? end + 1 : end;
+  }
+  bssl::ScopedCBB cbb;
+  // Every child stays linked to its parent until the parent is flushed, so
+  // all of them live as long as `cbb`.
+  CBB child, extensions, ext, list, name, versions;
+  EXPECT_TRUE(CBB_init(cbb.get(), 0));
+  EXPECT_TRUE(CBB_add_u16(cbb.get(), TLS1_2_VERSION));
+  EXPECT_TRUE(CBB_add_zeros(cbb.get(), SSL3_RANDOM_SIZE));
+  EXPECT_TRUE(CBB_add_u8_length_prefixed(cbb.get(), &child));
+  EXPECT_TRUE(CBB_add_zeros(&child, shape.session_id_len));
+  EXPECT_TRUE(CBB_add_u16_length_prefixed(cbb.get(), &child));
+  EXPECT_TRUE(
+      CBB_add_bytes(&child, cipher_suites.data(), cipher_suites.size()));
+  EXPECT_TRUE(CBB_add_u8_length_prefixed(cbb.get(), &child));
+  EXPECT_TRUE(CBB_add_u8(&child, 0));
+  EXPECT_TRUE(CBB_add_u16_length_prefixed(cbb.get(), &extensions));
+  for (const auto &[type, len] : shape_extensions) {
+    EXPECT_TRUE(CBB_add_u16(&extensions, type));
+    EXPECT_TRUE(CBB_add_u16_length_prefixed(&extensions, &ext));
+    if (type == TLSEXT_TYPE_server_name) {
+      EXPECT_TRUE(CBB_add_u16_length_prefixed(&ext, &list));
+      EXPECT_TRUE(CBB_add_u8(&list, TLSEXT_NAMETYPE_host_name));
+      EXPECT_TRUE(CBB_add_u16_length_prefixed(&list, &name));
+      EXPECT_TRUE(CBB_add_bytes(&name,
+                                reinterpret_cast<const uint8_t *>(kServerName),
+                                strlen(kServerName)));
+    } else if (type == TLSEXT_TYPE_supported_versions) {
+      EXPECT_TRUE(CBB_add_u8_length_prefixed(&ext, &versions));
+      EXPECT_TRUE(CBB_add_u16(&versions, TLS1_3_VERSION));
+      if (len == 5) {
+        EXPECT_TRUE(CBB_add_u16(&versions, TLS1_2_VERSION));
+      }
+    } else {
+      EXPECT_TRUE(CBB_add_zeros(&ext, len));
+    }
+    EXPECT_TRUE(CBB_flush(&ext));
+    EXPECT_EQ(len, CBB_len(&ext));
+    EXPECT_TRUE(CBB_flush(&extensions));
+  }
+  EXPECT_TRUE(CBB_flush(cbb.get()));
+  return std::vector<uint8_t>(CBB_data(cbb.get()),
+                              CBB_data(cbb.get()) + CBB_len(cbb.get()));
+}
