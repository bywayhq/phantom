+  SSL_CTX_set_session_cache_mode(client_ctx.get(), SSL_SESS_CACHE_BOTH);
+  SSL_CTX_set_early_data_enabled(client_ctx.get(), 1);
+  SSL_CTX_set_early_data_enabled(server_ctx.get(), 1);
+  bssl::UniquePtr<SSL_SESSION> session =
+      CreateClientSession(client_ctx.get(), server_ctx.get());
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_early_data_capable(session.get()));
+
+  std::vector<std::vector<uint8_t>> bodies;
+  ASSERT_TRUE(SSL_CTX_set_app_data(server_ctx.get(), &bodies));
+  SSL_CTX_set_select_certificate_cb(server_ctx.get(), RecordClientHelloBody);
+  for (bool resume : {false, true}) {
+    bssl::UniquePtr<SSL> client, server;
+    ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx.get(),
+                                      server_ctx.get()));
+    ASSERT_TRUE(SSL_set_tlsext_host_name(client.get(), "server.phantom.test"));
+    SSL_set_enable_ech_grease(client.get(), 1);
+    ASSERT_TRUE(SSL_set_ech_grease_payload_from_client_hello(client.get(), 100,
+                                                             nullptr, 0));
+    if (resume) {
+      SSL_set_session(client.get(), session.get());
+    }
+    ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+  }
+  ASSERT_EQ(2u, bodies.size());
+
+  bssl::UniquePtr<SSL> parser(SSL_new(client_ctx.get()));
+  ASSERT_TRUE(parser);
+  SSL_CLIENT_HELLO resumed;
+  ASSERT_TRUE(SSL_parse_client_hello(parser.get(), &resumed, bodies[1].data(),
+                                     bodies[1].size()));
+  const uint8_t *unused;
+  size_t unused_len;
+  ASSERT_TRUE(SSL_early_callback_ctx_extension_get(
+      &resumed, TLSEXT_TYPE_pre_shared_key, &unused, &unused_len));
+  ASSERT_TRUE(SSL_early_callback_ctx_extension_get(
+      &resumed, TLSEXT_TYPE_early_data, &unused, &unused_len));
+  for (const auto &body : bodies) {
+    EXPECT_EQ(NSSGreaseECHPayloadLength(parser.get(), body, 100),
+              GreaseECHPayloadLength(parser.get(), body));
+  }
+  // The ticket makes the resumed payload larger.
+  EXPECT_GT(GreaseECHPayloadLength(parser.get(), bodies[1]),
+            GreaseECHPayloadLength(parser.get(), bodies[0]));
