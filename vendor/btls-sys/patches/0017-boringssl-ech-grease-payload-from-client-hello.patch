+      ctx.get(),
+      [](SSL *ssl) {
+        return SSL_set_tlsext_host_name(ssl, "server.phantom.test") &&
+               SSL_set_ech_grease_payload_from_client_hello(ssl, 120, "a", 1);
+      },
+      &body));
+  EXPECT_EQ(NSSGreaseECHPayloadLength(parser.get(), body, 120, 1),
+            GreaseECHPayloadLength(parser.get(), body));
+  bssl::UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  EXPECT_FALSE(
+      SSL_set_ech_grease_payload_from_client_hello(ssl.get(), 100, nullptr, 3));
+  EXPECT_TRUE(ErrorsAreAndClear({{ERR_LIB_SSL, ERR_R_PASSED_NULL_PARAMETER}}));
+}
