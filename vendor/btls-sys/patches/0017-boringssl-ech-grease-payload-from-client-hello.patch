+// An IP-literal host sends no server_name, but the payload still pads by the
+// host text the caller passes.
+TEST(SSLTest, ECHGreasePayloadFromClientHelloPadsByHost) {
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  bssl::UniquePtr<SSL> parser(SSL_new(ctx.get()));
+  ASSERT_TRUE(parser);
+  for (const char *host : {"127.0.0.1", "::1", "192.168.100.200",
+                           "2001:db8:85a3::8a2e:370:7334"}) {
+    SCOPED_TRACE(host);
+    // Within any 32 consecutive maximum name lengths, the host length moves
+    // the payload across a 32-byte boundary at least once.
+    bool host_changed_payload = false;
+    for (uint8_t maximum_name_length = 100; maximum_name_length < 132;
+         maximum_name_length++) {
+      std::vector<uint8_t> body;
+      ASSERT_TRUE(GetGreaseClientHelloBody(
+          ctx.get(),
+          [&](SSL *ssl) {
+            return SSL_set_ech_grease_payload_from_client_hello(
+                ssl, maximum_name_length, host, strlen(host));
+          },
+          &body));
+      SSL_CLIENT_HELLO parsed;
+      const uint8_t *unused;
+      size_t unused_len;
+      ASSERT_TRUE(SSL_parse_client_hello(parser.get(), &parsed, body.data(),
+                                         body.size()));
+      EXPECT_FALSE(SSL_early_callback_ctx_extension_get(
+          &parsed, TLSEXT_TYPE_server_name, &unused, &unused_len));
+      const size_t payload_len = GreaseECHPayloadLength(parser.get(), body);
+      EXPECT_EQ(NSSGreaseECHPayloadLength(parser.get(), body,
+                                          maximum_name_length, strlen(host)),
+                payload_len);
+      if (payload_len !=
+          NSSGreaseECHPayloadLength(parser.get(), body, maximum_name_length)) {
+        host_changed_payload = true;
+      }
+    }
+    EXPECT_TRUE(host_changed_payload);
+  }
