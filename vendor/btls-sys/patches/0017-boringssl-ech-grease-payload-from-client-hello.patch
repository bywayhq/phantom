+// Firefox 157 sends GREASE ECH to IP literals without server_name, and pads by
+// the host text, "127.0.0.1" or "::1" without brackets. The TCP cases set
+// security.tls.ech.grease_size so that one more byte of host length moves the
+// payload across a 32-byte boundary, which pins the length Firefox pads with.
+// QUIC ignores that preference and uses 100.
+TEST(SSLTest, ECHGreasePayloadFromClientHelloMatchesFirefoxIPLiterals) {
+  static const char kTCPCiphers[] =
+      "130113031302c02bc02fcca9cca8c02cc030c013c014009c009d002f0035";
+  static const char kTCPExtensions[] =
+      "0017:0 ff01:1 000a:12 000b:2 0023:0 0010:14 0005:5 0022:10 0012:0 "
+      "0033:1327 002b:5 000d:24 002d:2 001c:2 001b:7 fe0d:282";
+  const struct {
+    const char *name;
+    ClientHelloShape shape;
+    const char *host;
+    uint8_t maximum_name_length;
+    size_t payload_len;
+  } kCases[] = {
+      {"TCP IPv4", {32, kTCPCiphers, kTCPExtensions}, "127.0.0.1", 100, 240},
+      {"TCP IPv4", {32, kTCPCiphers, kTCPExtensions}, "127.0.0.1", 93, 208},
+      {"TCP IPv4", {32, kTCPCiphers, kTCPExtensions}, "127.0.0.1", 94, 240},
+      {"TCP IPv6", {32, kTCPCiphers, kTCPExtensions}, "::1", 100, 240},
+      {"TCP IPv6", {32, kTCPCiphers, kTCPExtensions}, "::1", 87, 208},
+      {"TCP IPv6", {32, kTCPCiphers, kTCPExtensions}, "::1", 88, 240},
+      {"QUIC IPv4",
+       {0, "130113031302",
+        "000a:12 ff01:1 002d:2 0017:0 0033:1327 001c:2 001b:7 002b:3 0010:5 "
+        "000d:24 0005:5 0022:10 0039:86 fe0d:250"},
+       "127.0.0.1",
+       100,
+       208},
+  };
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  bssl::UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  for (const auto &c : kCases) {
+    SCOPED_TRACE(c.name);
+    SCOPED_TRACE(static_cast<int>(c.maximum_name_length));
+    std::vector<uint8_t> body = MakeClientHelloBody(c.shape);
+    size_t payload_len;
+    ASSERT_TRUE(ssl_ech_grease_payload_len_from_client_hello(
+        body, c.maximum_name_length, strlen(c.host), /*aead_overhead=*/16,
+        &payload_len));
+    EXPECT_EQ(c.payload_len, payload_len);
