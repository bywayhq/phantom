+// record_size_limit, extended_master_secret, and renegotiation_info.
+TEST_F(QUICMethodTest, ECHGreasePayloadFromClientHello) {
+  const SSL_QUIC_METHOD quic_method = DefaultQUICMethod();
+  ASSERT_TRUE(SSL_CTX_set_quic_method(client_ctx_.get(), &quic_method));
+  ASSERT_TRUE(SSL_CTX_set_quic_method(server_ctx_.get(), &quic_method));
+  SSL_CTX_set_session_cache_mode(client_ctx_.get(), SSL_SESS_CACHE_BOTH);
+  SSL_CTX_set_early_data_enabled(client_ctx_.get(), 1);
+  SSL_CTX_set_early_data_enabled(server_ctx_.get(), 1);
+  SSL_CTX_set_permute_extensions(client_ctx_.get(), 1);
+  static const uint16_t kTail[] = {TLSEXT_TYPE_quic_transport_parameters,
+                                   TLSEXT_TYPE_encrypted_client_hello};
+  ASSERT_TRUE(SSL_CTX_set_extension_order_tail(client_ctx_.get(), kTail,
+                                               std::size(kTail)));
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(client_ctx_.get(), 16385));
+  SSL_CTX_set_tls12_extensions_in_tls13_client_hello(client_ctx_.get(), 1);
+
+  bssl::UniquePtr<SSL_SESSION> session = CreateClientSessionForQUIC();
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_early_data_capable(session.get()));
+
+  std::vector<std::vector<uint8_t>> bodies;
+  ASSERT_TRUE(SSL_CTX_set_app_data(server_ctx_.get(), &bodies));
+  SSL_CTX_set_select_certificate_cb(server_ctx_.get(), RecordClientHelloBody);
+  for (bool resume : {false, true}) {
+    SCOPED_TRACE(resume);
+    ASSERT_TRUE(CreateClientAndServer());
+    ASSERT_TRUE(SSL_set_tlsext_host_name(client_.get(), "server.phantom.test"));
+    SSL_set_enable_ech_grease(client_.get(), 1);
+    ASSERT_TRUE(SSL_set_ech_grease_payload_from_client_hello(client_.get(), 100,
+                                                             nullptr, 0));
+    if (resume) {
+      SSL_set_session(client_.get(), session.get());
+      // The client enters early data and the server accepts it.
+      ASSERT_EQ(SSL_do_handshake(client_.get()), 1);
+      EXPECT_TRUE(SSL_in_early_data(client_.get()));
+      ASSERT_TRUE(ProvideHandshakeData(server_.get()));
+      ASSERT_EQ(SSL_do_handshake(server_.get()), 1);
+    }
+    ASSERT_TRUE(CompleteHandshakesForQUIC());
+    ExpectHandshakeSuccess();
+    EXPECT_EQ(resume, SSL_early_data_accepted(client_.get()));
+
+    ASSERT_EQ(1u, bodies.size());
+    const std::vector<uint8_t> body = std::move(bodies[0]);
+    bodies.clear();
+    SSL_CLIENT_HELLO parsed;
+    ASSERT_TRUE(SSL_parse_client_hello(client_.get(), &parsed, body.data(),
+                                       body.size()));
+    std::vector<uint16_t> order;
+    CBS extensions(Span(parsed.extensions, parsed.extensions_len));
+    while (CBS_len(&extensions) != 0) {
+      uint16_t type;
+      CBS unused;
+      ASSERT_TRUE(CBS_get_u16(&extensions, &type));
+      ASSERT_TRUE(CBS_get_u16_length_prefixed(&extensions, &unused));
+      order.push_back(type);
+    }
+    std::vector<uint16_t> expected_tail(std::begin(kTail), std::end(kTail));
+    if (resume) {
+      expected_tail.push_back(TLSEXT_TYPE_pre_shared_key);
+    }
+    EXPECT_TRUE(EndsWith(order, expected_tail));
+    for (uint16_t type :
+         {TLSEXT_TYPE_record_size_limit, TLSEXT_TYPE_extended_master_secret,
+          TLSEXT_TYPE_renegotiate}) {
+      EXPECT_NE(order.end(), std::find(order.begin(), order.end(), type))
+          << type;
+    }
+    EXPECT_EQ(resume, std::find(order.begin(), order.end(),
+                                TLSEXT_TYPE_early_data) != order.end());
+
+    const size_t payload_len = GreaseECHPayloadLength(client_.get(), body);
+    EXPECT_EQ(NSSGreaseECHPayloadLength(client_.get(), body, 100), payload_len);
+    EXPECT_EQ(0u, (payload_len - 16) % 32);
+  }
+}
