---
 ssl/ssl_privkey.cc | 21 +++------------------
 ssl/ssl_test.cc    | 19 +++++++++++++------
 2 files changed, 16 insertions(+), 24 deletions(-)

diff --git a/ssl/ssl_privkey.cc b/ssl/ssl_privkey.cc
index f2ab17e68..147cfcb80 100644
--- a/ssl/ssl_privkey.cc
+++ b/ssl/ssl_privkey.cc
@@ -591,24 +591,9 @@ int SSL_is_signature_algorithm_rsa_pss(uint16_t sigalg) {
   return alg != nullptr && alg->is_rsa_pss;
 }
 
-static bool sigalgs_unique(Span<const uint16_t> in_sigalgs) {
-  if (in_sigalgs.size() < 2) {
-    return true;
-  }
-
-  Array<uint16_t> sigalgs;
-  if (!sigalgs.CopyFrom(in_sigalgs)) {
-    return false;
-  }
-
-  std::sort(sigalgs.begin(), sigalgs.end());
-  for (size_t i = 1; i < sigalgs.size(); i++) {
-    if (sigalgs[i - 1] == sigalgs[i]) {
-      OPENSSL_PUT_ERROR(SSL, SSL_R_DUPLICATE_SIGNATURE_ALGORITHM);
-      return false;
-    }
-  }
-
+static bool sigalgs_unique(Span<const uint16_t> /*in_sigalgs*/) {
+  // boringssl.patch accepts duplicate signature algorithms for legacy client
+  // compatibility. Older Safari 15 variants can send duplicate preferences.
   return true;
 }
 
diff --git a/ssl/ssl_test.cc b/ssl/ssl_test.cc
index 52f2d2ddb..3bf56d91d 100644
--- a/ssl/ssl_test.cc
+++ b/ssl/ssl_test.cc
@@ -7438,7 +7438,9 @@ TEST(SSLTest, SigAlgs) {
       {{1}, false, {}},
       {{1, 2, 3}, false, {}},
       {{NID_sha256, EVP_PKEY_ED25519}, false, {}},
-      {{NID_sha256, EVP_PKEY_RSA, NID_sha256, EVP_PKEY_RSA}, false, {}},
+      {{NID_sha256, EVP_PKEY_RSA, NID_sha256, EVP_PKEY_RSA},
+       true,
+       {SSL_SIGN_RSA_PKCS1_SHA256, SSL_SIGN_RSA_PKCS1_SHA256}},
       {{NID_sha256, EVP_PKEY_ML_DSA_44}, false, {}},
 
       {{NID_sha256, EVP_PKEY_RSA}, true, {SSL_SIGN_RSA_PKCS1_SHA256}},
@@ -7493,8 +7495,13 @@ TEST(SSLTest, SigAlgsList) {
       {":RSA+SHA256+:", false, {}},
       {"!", false, {}},
       {"\x01", false, {}},
-      {"RSA+SHA256:RSA+SHA384:RSA+SHA256", false, {}},
-      {"RSA-PSS+SHA256:rsa_pss_rsae_sha256", false, {}},
+      {"RSA+SHA256:RSA+SHA384:RSA+SHA256",
+       true,
+       {SSL_SIGN_RSA_PKCS1_SHA256, SSL_SIGN_RSA_PKCS1_SHA384,
+        SSL_SIGN_RSA_PKCS1_SHA256}},
+      {"RSA-PSS+SHA256:rsa_pss_rsae_sha256",
+       true,
+       {SSL_SIGN_RSA_PSS_RSAE_SHA256, SSL_SIGN_RSA_PSS_RSAE_SHA256}},
 
       {"RSA+SHA256", true, {SSL_SIGN_RSA_PKCS1_SHA256}},
       {"RSA+SHA256:ed25519",
@@ -11326,10 +11333,10 @@ TEST(SSLTest, InvalidSignatureAlgorithm) {
 
   static const uint16_t kDuplicatePrefs[] = {SSL_SIGN_RSA_PKCS1_SHA256,
                                              SSL_SIGN_RSA_PKCS1_SHA256};
-  EXPECT_FALSE(SSL_CTX_set_signing_algorithm_prefs(ctx.get(), kDuplicatePrefs,
-                                                   std::size(kDuplicatePrefs)));
-  EXPECT_FALSE(SSL_CTX_set_verify_algorithm_prefs(ctx.get(), kDuplicatePrefs,
+  EXPECT_TRUE(SSL_CTX_set_signing_algorithm_prefs(ctx.get(), kDuplicatePrefs,
                                                   std::size(kDuplicatePrefs)));
+  EXPECT_TRUE(SSL_CTX_set_verify_algorithm_prefs(ctx.get(), kDuplicatePrefs,
+                                                 std::size(kDuplicatePrefs)));
 }
 
 TEST(SSLTest, InvalidGroups) {
