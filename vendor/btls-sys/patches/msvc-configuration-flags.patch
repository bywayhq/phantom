+                _ => panic!("unexpected CMake profile: {profile}"),
+            };
+            let configuration = profile.to_ascii_uppercase();
+            for language in ["C", "CXX"] {
+                boringssl_cmake.define(format!("CMAKE_{language}_FLAGS_{configuration}"), flags);
