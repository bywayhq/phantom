+            let flags = match profile {
+                "Debug" => "/Zi /Ob0 /Od /RTC1",
+                "Release" => "/O2 /Ob2 /DNDEBUG",
+                "RelWithDebInfo" => "/Zi /O2 /Ob1 /DNDEBUG",
