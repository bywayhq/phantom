+// GetFirstClientHelloExtension sets `*out` to the body of extension `type` in
+// the first ClientHello `ssl` sends, or to std::nullopt if it is absent.
+static bool GetFirstClientHelloExtension(
+    SSL *ssl, uint16_t type, std::optional<std::vector<uint8_t>> *out) {
+  std::vector<uint8_t> client_hello;
+  SSL_CLIENT_HELLO parsed;
+  if (!GetClientHello(ssl, &client_hello)) {
+    return false;
+  }
+  auto body =
+      Span(client_hello).subspan(SSL3_RT_HEADER_LENGTH + SSL3_HM_HEADER_LENGTH);
+  if (!SSL_parse_client_hello(ssl, &parsed, body.data(), body.size())) {
+    return false;
+  }
+  const uint8_t *data;
+  size_t len;
+  if (SSL_early_callback_ctx_extension_get(&parsed, type, &data, &len)) {
+    *out = std::vector<uint8_t>(data, data + len);
+  } else {
+    *out = std::nullopt;
+  }
+  return true;
+}
+
+// A client whose minimum version is TLS 1.3 omits extended_master_secret and
+// renegotiation_info unless configured to send them. Either way, a TLS 1.3
+// handshake completes.
+TEST(SSLTest, TLS12ExtensionsInTLS13ClientHello) {
+  bssl::UniquePtr<SSL_CTX> server_ctx =
+      CreateContextWithTestCertificate(TLS_method());
+  ASSERT_TRUE(server_ctx);
+  for (bool enabled : {false, true}) {
+    SCOPED_TRACE(enabled);
+    bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    ConfigureVersion(ctx.get(), TLS1_3_VERSION);
+    SSL_CTX_set_tls12_extensions_in_tls13_client_hello(ctx.get(), enabled);
+
+    bssl::UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    SSL_set_connect_state(ssl.get());
+    std::optional<std::vector<uint8_t>> ems, ri;
+    ASSERT_TRUE(GetFirstClientHelloExtension(
+        ssl.get(), TLSEXT_TYPE_extended_master_secret, &ems));
+    ssl.reset(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    SSL_set_connect_state(ssl.get());
+    ASSERT_TRUE(
+        GetFirstClientHelloExtension(ssl.get(), TLSEXT_TYPE_renegotiate, &ri));
+    if (enabled) {
+      EXPECT_EQ(ems, std::vector<uint8_t>{});
+      // An empty renegotiated_connection.
+      EXPECT_EQ(ri, std::vector<uint8_t>{0});
+    } else {
+      EXPECT_FALSE(ems);
+      EXPECT_FALSE(ri);
+    }
+
+    bssl::UniquePtr<SSL> client, server;
+    ASSERT_TRUE(
+        ConnectClientAndServer(&client, &server, ctx.get(), server_ctx.get()));
+    EXPECT_EQ(TLS1_3_VERSION, SSL_version(client.get()));
+  }
+
+  // The connection setting overrides the context, and SSL_OP_NO_RENEGOTIATION
+  // still omits renegotiation_info.
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  ConfigureVersion(ctx.get(), TLS1_3_VERSION);
+  SSL_CTX_set_tls12_extensions_in_tls13_client_hello(ctx.get(), 1);
+  bssl::UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  SSL_set_tls12_extensions_in_tls13_client_hello(ssl.get(), 0);
+  SSL_set_connect_state(ssl.get());
+  std::optional<std::vector<uint8_t>> ems, ri;
+  ASSERT_TRUE(GetFirstClientHelloExtension(
+      ssl.get(), TLSEXT_TYPE_extended_master_secret, &ems));
+  EXPECT_FALSE(ems);
+  ssl.reset(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  SSL_set_options(ssl.get(), SSL_OP_NO_RENEGOTIATION);
+  SSL_set_connect_state(ssl.get());
+  ASSERT_TRUE(
+      GetFirstClientHelloExtension(ssl.get(), TLSEXT_TYPE_renegotiate, &ri));
+  EXPECT_FALSE(ri);
+}
+
+// With ECH, only ClientHelloOuter carries the extensions, as in NSS, because
+// ClientHelloInner cannot negotiate TLS 1.2.
+TEST(SSLTest, TLS12ExtensionsInTLS13ClientHelloOuterOnly) {
+  bssl::UniquePtr<SSL_ECH_KEYS> keys = MakeTestECHKeys();
+  ASSERT_TRUE(keys);
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  ConfigureVersion(ctx.get(), TLS1_3_VERSION);
+  SSL_CTX_set_tls12_extensions_in_tls13_client_hello(ctx.get(), 1);
+  const auto contains = [](const std::vector<uint16_t> &order, uint16_t type) {
+    return std::find(order.begin(), order.end(), type) != order.end();
+  };
+
+  std::vector<uint16_t> outer, inner;
+  ASSERT_TRUE(
+      GetExtensionOrder(ctx.get(), &outer, keys.get(), /*decrypt_ech=*/false));
+  EXPECT_TRUE(contains(outer, TLSEXT_TYPE_extended_master_secret));
+  EXPECT_TRUE(contains(outer, TLSEXT_TYPE_renegotiate));
+  ASSERT_TRUE(
+      GetExtensionOrder(ctx.get(), &inner, keys.get(), /*decrypt_ech=*/true));
+  EXPECT_FALSE(contains(inner, TLSEXT_TYPE_extended_master_secret));
+  EXPECT_FALSE(contains(inner, TLSEXT_TYPE_renegotiate));
+}
+
+// Sending extended_master_secret in a TLS 1.3 ClientHello does not make a TLS
+// 1.3 echo acceptable: the client still rejects it in EncryptedExtensions.
+TEST(SSLTest, TLS12ExtensionsInTLS13ClientHelloRejectEchoedEMS) {
+  bssl::UniquePtr<SSL_CTX> client_ctx(SSL_CTX_new(TLS_method()));
+  bssl::UniquePtr<SSL_CTX> server_ctx =
+      CreateContextWithTestCertificate(TLS_method());
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  ConfigureVersion(client_ctx.get(), TLS1_3_VERSION);
+  SSL_CTX_set_tls12_extensions_in_tls13_client_hello(client_ctx.get(), 1);
+  // A TLS 1.3 server ignores the extension. Mark it negotiated after the
+  // server parses the ClientHello, so EncryptedExtensions echoes it.
+  SSL_CTX_set_cert_cb(
+      server_ctx.get(),
+      [](SSL *ssl, void *) -> int {
+        FromOpaque(ssl)->s3->hs->extended_master_secret = true;
+        return 1;
+      },
+      nullptr);
+
+  bssl::UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx.get(),
+                                    server_ctx.get()));
+  EXPECT_FALSE(CompleteHandshakes(client.get(), server.get()));
+  EXPECT_EQ(ERR_GET_REASON(ERR_peek_error()), SSL_R_ERROR_PARSING_EXTENSION);
+  ERR_clear_error();
+}
+
 // QUIC sends quic_transport_parameters, so a QUIC client can end its fresh and
 // resumed ClientHellos with quic_transport_parameters and
 // encrypted_client_hello, followed only by pre_shared_key.
