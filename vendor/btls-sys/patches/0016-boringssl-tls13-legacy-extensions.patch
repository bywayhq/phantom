     return true;
@@ -869,8 +871,11 @@ static bool ext_ri_add_serverhello(SSL_HANDSHAKE *hs, CBB *out) {
 static bool ext_ems_add_clienthello(const SSL_HANDSHAKE *hs, CBB *out,
                                     CBB *out_compressible,
                                     ssl_client_hello_type_t type) {
-  // Extended master secret is not necessary in TLS 1.3.
-  if (hs->min_version >= TLS1_3_VERSION || type == ssl_client_hello_inner) {
+  // Extended master secret is not necessary in TLS 1.3, but some clients, such
