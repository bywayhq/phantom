+// SSL_CTX_set_tls12_extensions_in_tls13_client_hello configures whether
+// clients created from |ctx| send the extended_master_secret and
+// renegotiation_info extensions when their minimum version is TLS 1.3, as NSS
+// does. Both only affect TLS 1.2 and earlier, and are omitted from such a
+// ClientHello by default. A ClientHelloInner never carries them, and
+// |SSL_OP_NO_RENEGOTIATION| still omits renegotiation_info. A server that
+// echoes either extension in TLS 1.3 is still rejected. This applies to TLS
+// and QUIC.
+OPENSSL_EXPORT void SSL_CTX_set_tls12_extensions_in_tls13_client_hello(
+    SSL_CTX *ctx, int enabled);
+
+// SSL_set_tls12_extensions_in_tls13_client_hello configures whether `ssl`
+// sends extended_master_secret and renegotiation_info when its minimum version
+// is TLS 1.3. See |SSL_CTX_set_tls12_extensions_in_tls13_client_hello|.
+OPENSSL_EXPORT void SSL_set_tls12_extensions_in_tls13_client_hello(SSL *ssl,
+                                                                   int enabled);
