+// QUIC is TLS 1.3-only, so a QUIC client sends extended_master_secret and
+// renegotiation_info only when configured to, and the handshake completes.
+TEST_F(QUICMethodTest, TLS12ExtensionsInTLS13ClientHello) {
+  const SSL_QUIC_METHOD quic_method = DefaultQUICMethod();
+  ASSERT_TRUE(SSL_CTX_set_quic_method(client_ctx_.get(), &quic_method));
+  ASSERT_TRUE(SSL_CTX_set_quic_method(server_ctx_.get(), &quic_method));
+
+  struct Seen {
+    bool ems = false;
+    bool ri = false;
+  };
+  for (bool enabled : {false, true}) {
+    SCOPED_TRACE(enabled);
+    SSL_CTX_set_tls12_extensions_in_tls13_client_hello(client_ctx_.get(),
+                                                       enabled);
+    Seen seen;
+    ASSERT_TRUE(SSL_CTX_set_app_data(server_ctx_.get(), &seen));
+    SSL_CTX_set_select_certificate_cb(
+        server_ctx_.get(),
+        [](const SSL_CLIENT_HELLO *client_hello) -> ssl_select_cert_result_t {
+          auto *out = static_cast<Seen *>(
+              SSL_CTX_get_app_data(SSL_get_SSL_CTX(client_hello->ssl)));
+          const uint8_t *data;
+          size_t len;
+          out->ems = SSL_early_callback_ctx_extension_get(
+                         client_hello, TLSEXT_TYPE_extended_master_secret,
+                         &data, &len) &&
+                     len == 0;
+          out->ri = SSL_early_callback_ctx_extension_get(
+                        client_hello, TLSEXT_TYPE_renegotiate, &data, &len) &&
+                    len == 1 && data[0] == 0;
+          return ssl_select_cert_success;
+        });
+
+    ASSERT_TRUE(CreateClientAndServer());
+    ASSERT_TRUE(CompleteHandshakesForQUIC());
+    ExpectHandshakeSuccess();
+    EXPECT_EQ(enabled, seen.ems);
+    EXPECT_EQ(enabled, seen.ri);
+  }
+}
+
