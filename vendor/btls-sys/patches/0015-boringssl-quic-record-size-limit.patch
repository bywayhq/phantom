diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index 455e03ee4..ec2d00e25 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5709,21 +5709,25 @@ OPENSSL_EXPORT int SSL_CTX_set_extension_order_tail(SSL_CTX *ctx,
 // plaintext |ssl| is willing to receive, as specified by RFC 8449. |limit|
 // must be zero (to disable the extension) or between 64 and 16385 inclusive.
 // It returns one on success and zero if |limit| is invalid, the handshake
-// configuration has been shed, or |ssl| uses DTLS, QUIC, or handoff.
+// configuration has been shed, or |ssl| uses DTLS or handoff.
 //
 // A TLS 1.3 client sends early data before it learns the server's limit, so
 // 0-RTT records may carry the protocol maximum of 2^14+1 bytes of
 // TLSInnerPlaintext for the whole 0-RTT epoch. A server that negotiates a
 // smaller limit therefore neither issues early-data tickets nor accepts early
 // data, and `SSL_get_early_data_reason` reports `ssl_early_data_disabled`.
+//
+// QUIC does not use TLS records. A QUIC client sends the extension and accepts
+// the server's, and a QUIC server negotiates it, but no limit applies to the
+// connection, and the limit does not affect early data.
 OPENSSL_EXPORT int SSL_set_record_size_limit(SSL *ssl, uint16_t limit);
 
 // SSL_CTX_set_record_size_limit configures the default RFC 8449 receive limit
 // for new TLS connections from |ctx|. |limit| has the same range as
-// SSL_set_record_size_limit. DTLS contexts reject non-zero limits. QUIC rejects
-// conflicting configuration when either option is set. Handoff rejects the
-// limit when it is set after handoff mode and otherwise rejects the connection
-// when the handshake begins.
+// SSL_set_record_size_limit. DTLS contexts reject non-zero limits. Handoff
+// rejects the limit when it is set after handoff mode and otherwise rejects the
+// connection when the handshake begins. A QUIC context accepts the limit with
+// the effect SSL_set_record_size_limit describes.
 OPENSSL_EXPORT int SSL_CTX_set_record_size_limit(SSL_CTX *ctx, uint16_t limit);
 
 // SSL_CTX_set_preserve_tls13_cipher_list configures whether sockets on |ctx|
