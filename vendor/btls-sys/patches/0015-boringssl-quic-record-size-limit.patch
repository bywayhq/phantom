+// QUIC carries TLS handshake messages in its own frames and never uses the TLS
+// record layer, so a QUIC endpoint negotiates the extension but no limit
+// applies. RFC 9001 does not forbid it, and Firefox sends it over QUIC.
 static bool record_size_limit_add_clienthello(
     const SSL_HANDSHAKE *hs, CBB *out, CBB *, ssl_client_hello_type_t) {
-  if (hs->record_size_limit == 0 || SSL_is_dtls(hs->ssl) ||
-      SSL_is_quic(hs->ssl)) {
+  if (hs->record_size_limit == 0 || SSL_is_dtls(hs->ssl)) {
     return true;
   }
 
