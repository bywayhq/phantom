+// QUICRecordSizeLimits records the record_size_limit a QUIC server read in
+// ClientHello and the one a QUIC client read in EncryptedExtensions.
+struct QUICRecordSizeLimits {
+  std::optional<uint16_t> offered;
+  std::optional<uint16_t> echoed;
+};
+
+static std::optional<uint16_t> ParseRecordSizeLimit(CBS body) {
+  uint16_t limit;
+  if (!CBS_get_u16(&body, &limit) || CBS_len(&body) != 0) {
+    ADD_FAILURE() << "Malformed record_size_limit";
+    return std::nullopt;
+  }
+  return limit;
+}
+
+static ssl_select_cert_result_t RecordOfferedRecordSizeLimit(
+    const SSL_CLIENT_HELLO *client_hello) {
+  auto *limits = static_cast<QUICRecordSizeLimits *>(
+      SSL_CTX_get_app_data(SSL_get_SSL_CTX(client_hello->ssl)));
+  const uint8_t *data;
+  size_t len;
+  if (SSL_early_callback_ctx_extension_get(
+          client_hello, TLSEXT_TYPE_record_size_limit, &data, &len)) {
+    limits->offered = ParseRecordSizeLimit(CBS(Span(data, len)));
+  }
+  return ssl_select_cert_success;
+}
+
+static void RecordEchoedRecordSizeLimit(int is_write, int version,
+                                        int content_type, const void *buf,
+                                        size_t len, SSL *ssl, void *arg) {
+  auto msg = Span(static_cast<const uint8_t *>(buf), len);
+  if (is_write || content_type != SSL3_RT_HANDSHAKE || msg.empty() ||
+      msg[0] != SSL3_MT_ENCRYPTED_EXTENSIONS) {
+    return;
+  }
+  CBS cbs(msg.subspan(SSL3_HM_HEADER_LENGTH)), extensions;
+  if (!CBS_get_u16_length_prefixed(&cbs, &extensions)) {
+    ADD_FAILURE() << "Malformed EncryptedExtensions";
+    return;
+  }
+  while (CBS_len(&extensions) != 0) {
+    uint16_t type;
+    CBS body;
+    if (!CBS_get_u16(&extensions, &type) ||
+        !CBS_get_u16_length_prefixed(&extensions, &body)) {
+      ADD_FAILURE() << "Malformed EncryptedExtensions";
+      return;
+    }
+    if (type == TLSEXT_TYPE_record_size_limit) {
+      static_cast<QUICRecordSizeLimits *>(arg)->echoed =
+          ParseRecordSizeLimit(body);
+    }
+  }
+}
+
+// A QUIC client sends record_size_limit and accepts the server's echo. QUIC
+// carries handshake messages outside TLS records, so a 64-byte limit on both
+// sides still lets the larger Certificate message through.
+TEST_F(QUICMethodTest, RecordSizeLimitIsOfferedAndNegotiated) {
+  const SSL_QUIC_METHOD quic_method = DefaultQUICMethod();
+  ASSERT_TRUE(SSL_CTX_set_quic_method(client_ctx_.get(), &quic_method));
+  ASSERT_TRUE(SSL_CTX_set_quic_method(server_ctx_.get(), &quic_method));
+
+  const struct {
+    uint16_t client_limit;
+    uint16_t server_limit;
+  } kCases[] = {
+      {16385, 0},
+      {16385, 16385},
+      {16385, 1024},
+      {64, 64},
+  };
+  for (const auto &c : kCases) {
+    SCOPED_TRACE(c.client_limit);
+    SCOPED_TRACE(c.server_limit);
+    QUICRecordSizeLimits limits;
+    ASSERT_TRUE(SSL_CTX_set_app_data(server_ctx_.get(), &limits));
+    SSL_CTX_set_select_certificate_cb(server_ctx_.get(),
+                                      RecordOfferedRecordSizeLimit);
+    SSL_CTX_set_msg_callback(client_ctx_.get(), RecordEchoedRecordSizeLimit);
+    SSL_CTX_set_msg_callback_arg(client_ctx_.get(), &limits);
+    ASSERT_TRUE(
+        SSL_CTX_set_record_size_limit(client_ctx_.get(), c.client_limit));
+    ASSERT_TRUE(
+        SSL_CTX_set_record_size_limit(server_ctx_.get(), c.server_limit));
+
+    ASSERT_TRUE(CreateClientAndServer());
+    ASSERT_TRUE(CompleteHandshakesForQUIC());
+    ExpectHandshakeSuccess();
+    EXPECT_EQ(limits.offered, c.client_limit);
+    if (c.server_limit == 0) {
+      EXPECT_FALSE(limits.echoed);
+    } else {
+      EXPECT_EQ(limits.echoed, c.server_limit);
+    }
+  }
+}
+
+// QUIC 0-RTT does not use TLS records, so a server limit below the protocol
+// maximum still issues early-data tickets and accepts early data.
+TEST_F(QUICMethodTest, RecordSizeLimitAdmitsZeroRTT) {
+  const SSL_QUIC_METHOD quic_method = DefaultQUICMethod();
+  SSL_CTX_set_session_cache_mode(client_ctx_.get(), SSL_SESS_CACHE_BOTH);
+  SSL_CTX_set_early_data_enabled(client_ctx_.get(), 1);
+  SSL_CTX_set_early_data_enabled(server_ctx_.get(), 1);
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(client_ctx_.get(), 16385));
+  ASSERT_TRUE(SSL_CTX_set_record_size_limit(server_ctx_.get(), 64));
+  ASSERT_TRUE(SSL_CTX_set_quic_method(client_ctx_.get(), &quic_method));
+  ASSERT_TRUE(SSL_CTX_set_quic_method(server_ctx_.get(), &quic_method));
+
+  bssl::UniquePtr<SSL_SESSION> session = CreateClientSessionForQUIC();
+  ASSERT_TRUE(session);
+  EXPECT_TRUE(SSL_SESSION_early_data_capable(session.get()));
+
+  QUICRecordSizeLimits limits;
+  SSL_CTX_set_msg_callback(client_ctx_.get(), RecordEchoedRecordSizeLimit);
+  SSL_CTX_set_msg_callback_arg(client_ctx_.get(), &limits);
+  ASSERT_TRUE(CreateClientAndServer());
+  SSL_set_session(client_.get(), session.get());
+  ASSERT_EQ(SSL_do_handshake(client_.get()), 1);
+  EXPECT_TRUE(SSL_in_early_data(client_.get()));
+  EXPECT_TRUE(transport_->client()->HasWriteSecret(ssl_encryption_early_data));
+
+  ASSERT_TRUE(ProvideHandshakeData(server_.get()));
+  ASSERT_EQ(SSL_do_handshake(server_.get()), 1);
+  EXPECT_TRUE(SSL_in_early_data(server_.get()));
+  EXPECT_TRUE(transport_->SecretsMatch(ssl_encryption_early_data));
+
+  ASSERT_TRUE(CompleteHandshakesForQUIC());
+  ExpectHandshakeSuccess();
+  EXPECT_TRUE(SSL_session_reused(client_.get()));
+  EXPECT_TRUE(SSL_early_data_accepted(client_.get()));
+  EXPECT_TRUE(SSL_early_data_accepted(server_.get()));
+  EXPECT_EQ(SSL_get_early_data_reason(server_.get()), ssl_early_data_accepted);
+  EXPECT_EQ(limits.echoed, 64);
+}
+
 TEST_F(QUICMethodTest, ZeroRTTRejectMismatchedParameters) {
   const SSL_QUIC_METHOD quic_method = DefaultQUICMethod();
 
