diff --git a/ssl/ssl_privkey.cc b/ssl/ssl_privkey.cc
index ae7c9bbd5..f2ab17e68 100644
--- a/ssl/ssl_privkey.cc
+++ b/ssl/ssl_privkey.cc
@@ -128,6 +128,24 @@ static const SSL_SIGNATURE_ALGORITHM *get_signature_algorithm(uint16_t sigalg) {
   return nullptr;
 }
 
+bool ssl_is_delegated_credential_algorithm(uint16_t sigalg) {
+  const SSL_SIGNATURE_ALGORITHM *alg = get_signature_algorithm(sigalg);
+  // RFC 9345 requires TLS 1.3 CertificateVerify algorithms and forbids
+  // rsaEncryption keys. BoringSSL does not expose rsa_pss_pss schemes, so all
+  // RSA algorithms are excluded.
+  return alg != nullptr && alg->tls13_ok && !alg->client_only &&
+         alg->pkey_type != EVP_PKEY_RSA;
+}
+
+static bool ssl_is_delegated_credential_advertisement_algorithm(
+    uint16_t sigalg) {
+  // Firefox includes ECDSA-with-SHA1 in extension 34 even in a TLS 1.3
+  // ClientHello. It is useful for reproducing that ordered wire image, but it
+  // remains invalid if selected for a TLS 1.3 CertificateVerify.
+  return sigalg == SSL_SIGN_ECDSA_SHA1 ||
+         ssl_is_delegated_credential_algorithm(sigalg);
+}
+
 bssl::UniquePtr<EVP_PKEY> ssl_parse_peer_subject_public_key_info(
     Span<const uint8_t> spki) {
   // Ideally the set of reachable algorithms would flow from `SSL_CTX` for dead
@@ -971,3 +989,31 @@ int SSL_set_verify_algorithm_prefs(SSL *ssl, const uint16_t *prefs,
   return set_sigalg_prefs(&ssl_impl->config->verify_sigalgs,
                           Span(prefs, num_prefs));
 }
+
+int SSL_CTX_set_delegated_credentials(SSL_CTX *ctx, const char *str) {
+  if (!ctx) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+
+  SSLContext *const ctx_impl = FromOpaque(ctx);
+  if (ctx_impl->x509_method != &ssl_crypto_x509_method) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+
+  Array<uint16_t> sigalgs;
+  if (!parse_sigalgs_list(&sigalgs, str)) {
+    return 0;
+  }
+
+  for (const uint16_t sigalg : sigalgs) {
+    if (!ssl_is_delegated_credential_advertisement_algorithm(sigalg)) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_INVALID_SIGNATURE_ALGORITHM);
+      return 0;
+    }
+  }
+
+  return set_sigalg_prefs(&ctx_impl->delegated_credentials,
+                          MakeConstSpan(sigalgs.data(), sigalgs.size()));
+}
diff --git a/ssl/ssl_test.cc b/ssl/ssl_test.cc
index 4d8f6a6f2..52f2d2ddb 100644
--- a/ssl/ssl_test.cc
+++ b/ssl/ssl_test.cc
@@ -6479,6 +6479,39 @@ TEST(SSLTest, BuffersFailWithoutCustomVerify) {
                                      server_ctx.get()));
 }
 
+TEST(SSLTest, DelegatedCredentialConfiguration) {
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  EXPECT_TRUE(SSL_CTX_set_delegated_credentials(
+      ctx.get(), "ecdsa_secp256r1_sha256:ecdsa_secp384r1_sha384:"
+                 "ecdsa_secp521r1_sha512:ecdsa_sha1"));
+  const std::vector<uint16_t> expected = {
+      SSL_SIGN_ECDSA_SECP256R1_SHA256,
+      SSL_SIGN_ECDSA_SECP384R1_SHA384,
+      SSL_SIGN_ECDSA_SECP521R1_SHA512,
+      SSL_SIGN_ECDSA_SHA1,
+  };
+  const auto &configured = FromOpaque(ctx.get())->delegated_credentials;
+  EXPECT_EQ(expected,
+            std::vector<uint16_t>(configured.begin(), configured.end()));
+
+  // BoringSSL does not support the rsa_pss_pss schemes required for delegated
+  // RSA keys.
+  EXPECT_FALSE(
+      SSL_CTX_set_delegated_credentials(ctx.get(), "rsa_pss_rsae_sha256"));
+  ERR_clear_error();
+
+  // TLS_with_buffers_method promises not to link or invoke crypto/x509, while
+  // delegated credential authorization requires fields from the leaf X.509
+  // certificate.
+  bssl::UniquePtr<SSL_CTX> buffers_ctx(
+      SSL_CTX_new(TLS_with_buffers_method()));
+  ASSERT_TRUE(buffers_ctx);
+  EXPECT_FALSE(SSL_CTX_set_delegated_credentials(
+      buffers_ctx.get(), "ecdsa_secp256r1_sha256"));
+  ERR_clear_error();
+}
+
 TEST(SSLTest, CustomVerify) {
   bssl::UniquePtr<SSL_CTX> client_ctx(SSL_CTX_new(TLS_with_buffers_method()));
   ASSERT_TRUE(client_ctx);
