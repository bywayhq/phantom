diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index 034d7d6ff..4e5016618 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -1254,6 +1254,15 @@ OPENSSL_EXPORT int SSL_set_signing_algorithm_prefs(SSL *ssl,
                                                    size_t num_prefs);
 
 
+// SSL_CTX_set_delegated_credentials sets the ordered signature algorithms the
+// client advertises for delegated credential keys. `ecdsa_sha1` is accepted
+// for reproducing browser wire images, but remains invalid if selected in TLS
+// 1.3. RSAE algorithms are not accepted. This function is not supported by
+// `TLS_with_buffers_method`.
+OPENSSL_EXPORT int SSL_CTX_set_delegated_credentials(SSL_CTX *ctx,
+                                                     const char *str);
+
+
 // Certificate and private key convenience functions.
 
 // SSL_CTX_set_chain_and_key sets the certificate chain and private key for a
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index 577b2d840..44cbb6155 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -3320,6 +3320,38 @@ static bool ext_quic_transport_params_add_serverhello_legacy(SSL_HANDSHAKE *hs,
 static bool ext_delegated_credential_add_clienthello(
     const SSL_HANDSHAKE *hs, CBB *out, CBB *out_compressible,
     ssl_client_hello_type_t type) {
+  if (hs->config->delegated_credentials.empty()) {
+    return true;
+  }
+
+  // Delegated credentials are only defined for (D)TLS 1.3 and later. Do not
+  // add an identifying extension to a ClientHello which cannot negotiate it.
+  if (hs->max_version < TLS1_3_VERSION || type == ssl_client_hello_outer) {
+    return true;
+  }
+
+  hs->delegated_credential_sent = true;
+
+  CBB contents, data;
+  const Array<uint16_t> &signature_hash_algorithms =
+      hs->config->delegated_credentials;
+
+  if (!CBB_add_u16(out, TLSEXT_TYPE_delegated_credential) ||
+      !CBB_add_u16_length_prefixed(out, &contents) ||
+      !CBB_add_u16_length_prefixed(&contents, &data)) {
+    return false;
+  }
+
+  for (const uint16_t alg : signature_hash_algorithms) {
+    if (!CBB_add_u16(&data, alg)) {
+      return false;
+    }
+  }
+
+  if (!CBB_flush(out)) {
+    return false;
+  }
+
   return true;
 }
 
