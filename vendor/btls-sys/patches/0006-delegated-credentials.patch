 	algo signatureAlgorithm
 }
 
+// delegatedCredentialTestTime matches the synthetic clock used by bssl_shim
+// and the runner. Keeping credential validity relative to this value makes the
+// temporal checks deterministic.
+var delegatedCredentialTestTime = time.Unix(1234, 0)
+
+func createDelegationCertificate(key crypto.Signer, name string, keyUsage x509.KeyUsage, delegationUsage bool, notAfter time.Time) *Credential {
+	notBefore := delegatedCredentialTestTime.Add(-time.Hour)
+	if notAfter.IsZero() {
+		notAfter = delegatedCredentialTestTime.Add(time.Hour)
+	}
+	rootKey := crypto.Signer(&rsa2048Key)
+	if _, ok := key.(*rsa.PrivateKey); ok {
+		rootKey = &ecdsaP256Key
+	}
+	credential := NewX509Root(X509Info{
+		PrivateKey:   rootKey,
+		Name:         pkix.Name{CommonName: name + " Root"},
+		IsCA:         true,
+		SubjectKeyID: []byte(name + " root"),
+		NotBefore:    notBefore,
+		NotAfter:     notAfter,
+	}).Issue(X509Info{
+		PrivateKey:      key,
+		Name:            pkix.Name{CommonName: name},
+		DNSNames:        []string{"test"},
+		KeyUsage:        keyUsage,
+		DelegationUsage: delegationUsage,
+		NotBefore:       notBefore,
+		NotAfter:        notAfter,
+	}).ToCredential()
+	return &credential
+}
+
 func createDelegatedCredential(parent *Credential, config delegatedCredentialConfig) *Credential {
 	if parent.Type != CredentialTypeX509 {
 		panic("delegated credentials must be issued by X.509 credentials")
@@ -117,6 +153,19 @@ func createDelegatedCredential(parent *Credential, config delegatedCredentialCon
 	return &dcCred
 }
 
+func cloneDelegatedCredential(cred *Credential) *Credential {
+	clone := *cred
+	clone.DelegatedCredential = slices.Clone(cred.DelegatedCredential)
+	return &clone
+}
+
+func marshalDelegatedCredentialExtension(credential []byte) []byte {
+	extension := cryptobyte.NewBuilder(nil)
+	extension.AddUint16(extensionDelegatedCredential)
+	addUint16LengthPrefixedBytes(extension, credential)
+	return extension.BytesOrPanic()
+}
