+  mutable bool delegated_credential_sent = false;
+
   // new_session is the new mutable session being established by the current
   // handshake. It should not be cached.
   UniquePtr<SSL_SESSION> new_session;
@@ -3603,6 +3626,10 @@ struct SSL_CONFIG {
   // is willing to receive. Zero disables RFC 8449.
   uint16_t record_size_limit = 0;
 
+  // delegated_credentials, if not empty, is the set of signature algorithms
+  // supported by the client.
+  Array<uint16_t> delegated_credentials;
+
   // server_padding_enabled is true iff the server is willing to send additional
   // padding to clients that request it through the server padding extension.
   bool server_padding_enabled : 1;
@@ -4278,6 +4305,10 @@ class SSLContext : public ssl_ctx_st, public RefCounted<SSLContext> {
   // record_size_limit is copied to each new SSL_CONFIG. Zero disables RFC 8449.
   uint16_t record_size_limit = 0;
 
+  // delegated_credentials, if not empty, is the set of signature algorithms
+  // supported by the client.
