+// random order, before any tail set by |SSL_CTX_set_extension_order_tail|.
+// Passing an empty list clears the configured order. It returns one on success
+// and zero on allocation failure or if an ID is also in the tail.
 OPENSSL_EXPORT int SSL_CTX_set_extension_order(SSL_CTX *ctx,
                                                const uint16_t *ids, int num);
 
+// SSL_CTX_set_extension_order_tail sets ClientHello extensions that
+// connections created from |ctx| write after all others, in the given order.
+// Only the padding and pre_shared_key extensions follow them. If GREASE is
+// enabled, the trailing GREASE extension precedes them. Unknown and duplicate
+// IDs are ignored, and a listed extension is written only when the connection
+// would send it anyway.
+//
+// The extensions between the order set by |SSL_CTX_set_extension_order| and
+// the tail are shuffled if that order is set or extension permutation is
+// enabled, and keep the default order otherwise. The second ClientHello after
+// a HelloRetryRequest keeps the order. ClientHelloInner applies it as it does
+// the permutation of |SSL_CTX_set_permute_extensions|.
+//
+// Passing an empty list clears the tail. It returns one on success and zero on
+// allocation failure or if an ID is also in the order set by
+// |SSL_CTX_set_extension_order|.
+OPENSSL_EXPORT int SSL_CTX_set_extension_order_tail(SSL_CTX *ctx,
+                                                    const uint16_t *ids,
+                                                    size_t num);
+
