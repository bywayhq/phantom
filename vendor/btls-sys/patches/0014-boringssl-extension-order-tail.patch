+// extension_orders_overlap returns whether an ID appears in both `a` and `b`.
+static bool extension_orders_overlap(Span<const uint16_t> a,
+                                     Span<const uint16_t> b) {
+  for (uint16_t id : a) {
+    if (std::find(b.begin(), b.end(), id) != b.end()) {
+      return true;
+    }
+  }
+  return false;
+}
+
 int SSL_CTX_set_extension_order(SSL_CTX *ctx, const uint16_t *ids, int num) {
+  auto *ctx_impl = FromOpaque(ctx);
   Array<uint16_t> order;
   if (num > 0) {
     if (!order.Init(num)) {
@@ -3422,7 +3434,30 @@ int SSL_CTX_set_extension_order(SSL_CTX *ctx, const uint16_t *ids, int num) {
       order[i] = ids[i];
     }
   }
-  FromOpaque(ctx)->extension_order = std::move(order);
+  if (extension_orders_overlap(order, ctx_impl->extension_order_tail)) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DUPLICATE_EXTENSION);
+    return 0;
+  }
+  ctx_impl->extension_order = std::move(order);
+  return 1;
+}
+
+int SSL_CTX_set_extension_order_tail(SSL_CTX *ctx, const uint16_t *ids,
+                                     size_t num) {
+  auto *ctx_impl = FromOpaque(ctx);
+  if (num != 0 && ids == nullptr) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_PASSED_NULL_PARAMETER);
+    return 0;
+  }
+  Array<uint16_t> tail;
+  if (!tail.CopyFrom(Span(ids, num))) {
+    return 0;
+  }
+  if (extension_orders_overlap(tail, ctx_impl->extension_order)) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DUPLICATE_EXTENSION);
+    return 0;
+  }
+  ctx_impl->extension_order_tail = std::move(tail);
   return 1;
 }
 
diff --git a/ssl/ssl_test.cc b/ssl/ssl_test.cc
index 70f077d7f..1f081b159 100644
--- a/ssl/ssl_test.cc
+++ b/ssl/ssl_test.cc
@@ -11343,6 +11343,345 @@ TEST(SSLTest, ExtensionOrderPreservesPrefixAndShufflesRemainder) {
   EXPECT_TRUE(suffix_changed) << "Unlisted extensions were not shuffled";
 }
 
+// ExtensionTypesOf returns the extension types of `client_hello`, a complete
+// ClientHello handshake message, in wire order.
+static std::vector<uint16_t> ExtensionTypesOf(
+    SSL *ssl, Span<const uint8_t> client_hello) {
+  std::vector<uint16_t> types;
+  SSL_CLIENT_HELLO parsed;
+  auto body = client_hello.subspan(SSL3_HM_HEADER_LENGTH);
+  if (!SSL_parse_client_hello(ssl, &parsed, body.data(), body.size())) {
+    ADD_FAILURE() << "Could not parse ClientHello";
+    return types;
+  }
+  CBS extensions(Span(parsed.extensions, parsed.extensions_len));
+  while (CBS_len(&extensions) != 0) {
+    uint16_t type;
+    CBS unused;
+    if (!CBS_get_u16(&extensions, &type) ||
+        !CBS_get_u16_length_prefixed(&extensions, &unused)) {
+      ADD_FAILURE() << "Could not parse ClientHello extensions";
+      return types;
+    }
+    types.push_back(type);
+  }
+  return types;
+}
+
+// WithoutPadding returns `order` without the padding extension, which the
+// ClientHello writer adds after any configured tail.
+static std::vector<uint16_t> WithoutPadding(std::vector<uint16_t> order) {
+  order.erase(std::remove(order.begin(), order.end(), TLSEXT_TYPE_padding),
+              order.end());
+  return order;
+}
+
+static bool EndsWith(const std::vector<uint16_t> &order,
+                     const std::vector<uint16_t> &suffix) {
+  return order.size() >= suffix.size() &&
+         std::equal(suffix.begin(), suffix.end(), order.end() - suffix.size());
+}
+
+static bool IsGreaseExtension(uint16_t type) {
+  return (type & 0x0f0f) == 0x0a0a;
+}
+
+// The tail follows a shuffled middle part, both with and without ECH. The
+// ClientHello writer only adds padding after it.
+TEST(SSLTest, ExtensionOrderTailFollowsShuffledMiddle) {
+  bssl::UniquePtr<SSL_ECH_KEYS> keys = MakeTestECHKeys();
+  ASSERT_TRUE(keys);
+  static const uint16_t kTail[] = {
+      TLSEXT_TYPE_key_share,
+      0xffff,
+      TLSEXT_TYPE_key_share,
+      TLSEXT_TYPE_encrypted_client_hello,
+  };
+  for (bool offer_ech : {false, true}) {
+    SCOPED_TRACE(offer_ech);
+    bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    SSL_CTX_set_permute_extensions(ctx.get(), 1);
+    ASSERT_TRUE(
+        SSL_CTX_set_extension_order_tail(ctx.get(), kTail, std::size(kTail)));
+    const std::vector<uint16_t> expected_tail =
+        offer_ech ? std::vector<uint16_t>{TLSEXT_TYPE_key_share,
+                                          TLSEXT_TYPE_encrypted_client_hello}
+                  : std::vector<uint16_t>{TLSEXT_TYPE_key_share};
+
+    std::vector<uint16_t> first_order;
+    ASSERT_TRUE(GetExtensionOrder(ctx.get(), &first_order,
+                                  offer_ech ? keys.get() : nullptr,
+                                  /*decrypt_ech=*/false));
+    first_order = WithoutPadding(first_order);
+    ASSERT_TRUE(EndsWith(first_order, expected_tail));
+    ASSERT_GE(first_order.size(), 5u);
+
+    // See PermuteExtensions for the iteration count.
+    static const int kNumIterations = 14;
+    bool middle_changed = false;
+    for (int i = 0; i < kNumIterations; i++) {
+      std::vector<uint16_t> order;
+      ASSERT_TRUE(GetExtensionOrder(ctx.get(), &order,
+                                    offer_ech ? keys.get() : nullptr,
+                                    /*decrypt_ech=*/false));
+      order = WithoutPadding(order);
+      ASSERT_TRUE(EndsWith(order, expected_tail));
+      if (order != first_order) {
+        middle_changed = true;
+        break;
+      }
+    }
+    EXPECT_TRUE(middle_changed) << "The middle part was not shuffled";
+  }
+}
+
+// Without permutation or a prefix, the middle part keeps the default order.
+TEST(SSLTest, ExtensionOrderTailKeepsDefaultMiddleOrder) {
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  std::vector<uint16_t> default_order;
+  ASSERT_TRUE(GetExtensionOrder(ctx.get(), &default_order,
+                                /*ech_keys=*/nullptr, /*decrypt_ech=*/false));
+  default_order = WithoutPadding(default_order);
+
+  static const uint16_t kTail[] = {TLSEXT_TYPE_supported_versions};
+  ASSERT_TRUE(
+      SSL_CTX_set_extension_order_tail(ctx.get(), kTail, std::size(kTail)));
+  std::vector<uint16_t> expected = default_order;
+  expected.erase(std::remove(expected.begin(), expected.end(),
+                             TLSEXT_TYPE_supported_versions),
+                 expected.end());
+  ASSERT_EQ(expected.size() + 1, default_order.size());
+  expected.push_back(TLSEXT_TYPE_supported_versions);
+  for (int i = 0; i < 2; i++) {
+    std::vector<uint16_t> order;
+    ASSERT_TRUE(GetExtensionOrder(ctx.get(), &order, /*ech_keys=*/nullptr,
+                                  /*decrypt_ech=*/false));
+    EXPECT_EQ(expected, WithoutPadding(order));
+  }
+
+  // An empty list clears the tail.
+  ASSERT_TRUE(SSL_CTX_set_extension_order_tail(ctx.get(), nullptr, 0));
+  std::vector<uint16_t> order;
+  ASSERT_TRUE(GetExtensionOrder(ctx.get(), &order, /*ech_keys=*/nullptr,
+                                /*decrypt_ech=*/false));
+  EXPECT_EQ(default_order, WithoutPadding(order));
+}
+
