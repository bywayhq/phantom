+  ASSERT_TRUE(SSL_CTX_set_extension_order(
+      ctx.get(), kPrefix, static_cast<int>(std::size(kPrefix))));
+  ASSERT_TRUE(
+      SSL_CTX_set_extension_order_tail(ctx.get(), kTail, std::size(kTail)));
+
+  std::vector<uint16_t> first_order;
+  ASSERT_TRUE(GetExtensionOrder(ctx.get(), &first_order, /*ech_keys=*/nullptr,
+                                /*decrypt_ech=*/false));
+  first_order = WithoutPadding(first_order);
+  ASSERT_GE(first_order.size(), 5u);
+  EXPECT_EQ(TLSEXT_TYPE_supported_versions, first_order.front());
+  EXPECT_TRUE(EndsWith(first_order, {kTail[0], kTail[1]}));
+
+  static const int kNumIterations = 14;
+  bool middle_changed = false;
+  for (int i = 0; i < kNumIterations; i++) {
+    std::vector<uint16_t> order;
+    ASSERT_TRUE(GetExtensionOrder(ctx.get(), &order, /*ech_keys=*/nullptr,
+                                  /*decrypt_ech=*/false));
+    order = WithoutPadding(order);
+    ASSERT_EQ(TLSEXT_TYPE_supported_versions, order.front());
+    ASSERT_TRUE(EndsWith(order, {kTail[0], kTail[1]}));
+    if (order != first_order) {
+      middle_changed = true;
+      break;
+    }
+  }
+  EXPECT_TRUE(middle_changed) << "The middle part was not shuffled";
+}
+
+TEST(SSLTest, ExtensionOrderTailRejectsPrefixOverlap) {
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  static const uint16_t kPrefix[] = {TLSEXT_TYPE_supported_versions,
+                                     TLSEXT_TYPE_key_share};
+  static const uint16_t kTail[] = {TLSEXT_TYPE_supported_groups,
+                                   TLSEXT_TYPE_key_share};
+  ASSERT_TRUE(SSL_CTX_set_extension_order(
+      ctx.get(), kPrefix, static_cast<int>(std::size(kPrefix))));
+  EXPECT_FALSE(
+      SSL_CTX_set_extension_order_tail(ctx.get(), kTail, std::size(kTail)));
+  EXPECT_TRUE(ErrorsAreAndClear({{ERR_LIB_SSL, SSL_R_DUPLICATE_EXTENSION}}));
+  EXPECT_TRUE(FromOpaque(ctx.get())->extension_order_tail.empty());
+  EXPECT_FALSE(SSL_CTX_set_extension_order_tail(ctx.get(), nullptr, 1));
+  EXPECT_TRUE(ErrorsAreAndClear({{ERR_LIB_SSL, ERR_R_PASSED_NULL_PARAMETER}}));
+
+  // The prefix setter checks the other direction.
+  ASSERT_TRUE(SSL_CTX_set_extension_order(ctx.get(), nullptr, 0));
+  ASSERT_TRUE(
+      SSL_CTX_set_extension_order_tail(ctx.get(), kTail, std::size(kTail)));
+  EXPECT_FALSE(SSL_CTX_set_extension_order(
+      ctx.get(), kPrefix, static_cast<int>(std::size(kPrefix))));
+  EXPECT_TRUE(ErrorsAreAndClear({{ERR_LIB_SSL, SSL_R_DUPLICATE_EXTENSION}}));
+  EXPECT_TRUE(FromOpaque(ctx.get())->extension_order.empty());
+}
