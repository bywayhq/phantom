index 004942bd0..0554fdee9 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -3412,7 +3412,19 @@ void SSL_set_permute_extensions(SSL *ssl, int enabled) {
