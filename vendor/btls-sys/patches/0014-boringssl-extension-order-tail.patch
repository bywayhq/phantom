+// The trailing GREASE extension precedes the tail. A compressed tail extension
+// keeps its relative order in ech_outer_extensions, so the server decodes
+// ClientHelloInner.
+TEST(SSLTest, ExtensionOrderTailFollowsGreaseAndSurvivesECH) {
+  bssl::UniquePtr<SSL_ECH_KEYS> keys = MakeTestECHKeys();
+  ASSERT_TRUE(keys);
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  SSL_CTX_set_grease_enabled(ctx.get(), 1);
+  SSL_CTX_set_permute_extensions(ctx.get(), 1);
+  static const uint16_t kTail[] = {TLSEXT_TYPE_key_share,
+                                   TLSEXT_TYPE_encrypted_client_hello};
+  ASSERT_TRUE(
+      SSL_CTX_set_extension_order_tail(ctx.get(), kTail, std::size(kTail)));
+
+  for (int i = 0; i < 4; i++) {
+    std::vector<uint16_t> outer, inner;
+    ASSERT_TRUE(GetExtensionOrder(ctx.get(), &outer, keys.get(),
+                                  /*decrypt_ech=*/false));
+    outer = WithoutPadding(outer);
+    ASSERT_GE(outer.size(), 3u);
+    EXPECT_TRUE(EndsWith(outer, {kTail[0], kTail[1]}));
+    EXPECT_TRUE(IsGreaseExtension(outer[outer.size() - 3]));
+
+    // ClientHelloInner writes compressed extensions last, so key_share, the
+    // compressed tail extension, ends it and follows the trailing GREASE.
+    ASSERT_TRUE(GetExtensionOrder(ctx.get(), &inner, keys.get(),
+                                  /*decrypt_ech=*/true));
+    ASSERT_GE(inner.size(), 2u);
+    EXPECT_EQ(TLSEXT_TYPE_key_share, inner.back());
+    EXPECT_TRUE(IsGreaseExtension(inner[inner.size() - 2]));
+  }
+}
