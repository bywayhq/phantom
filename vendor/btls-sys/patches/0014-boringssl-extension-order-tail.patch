+// QUIC sends quic_transport_parameters, so a QUIC client can end its fresh and
+// resumed ClientHellos with quic_transport_parameters and
+// encrypted_client_hello, followed only by pre_shared_key.
+TEST_F(QUICMethodTest, ExtensionOrderTail) {
+  const SSL_QUIC_METHOD quic_method = DefaultQUICMethod();
+  ASSERT_TRUE(SSL_CTX_set_quic_method(client_ctx_.get(), &quic_method));
+  ASSERT_TRUE(SSL_CTX_set_quic_method(server_ctx_.get(), &quic_method));
+  SSL_CTX_set_session_cache_mode(client_ctx_.get(), SSL_SESS_CACHE_BOTH);
+  SSL_CTX_set_permute_extensions(client_ctx_.get(), 1);
+  static const uint16_t kTail[] = {
+      TLSEXT_TYPE_quic_transport_parameters,
+      TLSEXT_TYPE_encrypted_client_hello,
+  };
+  ASSERT_TRUE(SSL_CTX_set_extension_order_tail(client_ctx_.get(), kTail,
+                                               std::size(kTail)));
+  std::vector<std::vector<uint16_t>> orders;
+  ASSERT_TRUE(SSL_CTX_set_app_data(server_ctx_.get(), &orders));
+  SSL_CTX_set_select_certificate_cb(
+      server_ctx_.get(),
+      [](const SSL_CLIENT_HELLO *client_hello) -> ssl_select_cert_result_t {
+        auto *out = static_cast<std::vector<std::vector<uint16_t>> *>(
+            SSL_CTX_get_app_data(SSL_get_SSL_CTX(client_hello->ssl)));
+        std::vector<uint16_t> types;
+        CBS extensions(
+            Span(client_hello->extensions, client_hello->extensions_len));
+        while (CBS_len(&extensions) != 0) {
+          uint16_t type;
+          CBS unused;
+          if (!CBS_get_u16(&extensions, &type) ||
+              !CBS_get_u16_length_prefixed(&extensions, &unused)) {
+            return ssl_select_cert_error;
+          }
+          types.push_back(type);
+        }
+        out->push_back(std::move(types));
+        return ssl_select_cert_success;
+      });
+
+  static const int kNumIterations = 8;
+  for (int i = 0; i < kNumIterations; i++) {
+    ASSERT_TRUE(CreateClientAndServer());
+    SSL_set_enable_ech_grease(client_.get(), 1);
+    ASSERT_TRUE(CompleteHandshakesForQUIC());
+    ExpectHandshakeSuccess();
+  }
+  ASSERT_EQ(static_cast<size_t>(kNumIterations), orders.size());
+  std::set<std::vector<uint16_t>> distinct;
+  for (const auto &order : orders) {
+    EXPECT_TRUE(EndsWith(order, {kTail[0], kTail[1]}));
+    distinct.insert(order);
+  }
+  EXPECT_GT(distinct.size(), 1u) << "The middle part was not shuffled";
+
+  // A resumed ClientHello adds pre_shared_key after the tail.
+  bssl::UniquePtr<SSL_SESSION> session = CreateClientSessionForQUIC();
+  ASSERT_TRUE(session);
+  orders.clear();
+  ASSERT_TRUE(CreateClientAndServer());
+  SSL_set_enable_ech_grease(client_.get(), 1);
+  SSL_set_session(client_.get(), session.get());
+  ASSERT_TRUE(CompleteHandshakesForQUIC());
+  ExpectHandshakeSuccess();
+  EXPECT_TRUE(SSL_session_reused(client_.get()));
+  ASSERT_EQ(1u, orders.size());
+  EXPECT_TRUE(
+      EndsWith(orders[0], {kTail[0], kTail[1], TLSEXT_TYPE_pre_shared_key}));
+}
