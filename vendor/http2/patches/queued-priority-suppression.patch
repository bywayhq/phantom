@@ -390,4 +390,5 @@
         store: &mut Store,
         counts: &mut Counts,
+        peer_ignores_rfc7540_priorities: bool,
         dst: &mut Codec<T, Prioritized<B>>,
     ) -> Poll<io::Result<()>>
@@ -396,6 +397,12 @@
         B: Buf,
     {
-        self.prioritize
-            .poll_complete(cx, buffer, store, counts, dst)
+        self.prioritize.poll_complete(
+            cx,
