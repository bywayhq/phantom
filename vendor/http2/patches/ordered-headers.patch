+#[tokio::test]
+async fn wire_settings_transitions_remain_sticky() {
+    timeout(Duration::from_secs(2), async {
+        let (client_io, mut peer_io) = duplex(16 * 1024);
+        let (sender, connection) = super::handshake(client_io)
