{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree list *)",
      "Bash(cargo check *)",
      "Bash(cargo +1.85.0 check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo doc *)",
      "Bash(cargo fmt)",
      "Bash(cargo fmt --check *)",
      "Bash(cargo fmt -- --check)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(rustfmt --edition 2024 *)",
      "Bash(scripts/dev/with-cargo-lock.sh cargo check *)",
      "Bash(scripts/dev/with-cargo-lock.sh cargo +1.85.0 check *)",
      "Bash(scripts/dev/with-cargo-lock.sh cargo clippy *)",
      "Bash(scripts/dev/with-cargo-lock.sh cargo test *)",
      "Bash(scripts/dev/with-cargo-lock.sh cargo doc *)",
      "Bash(scripts/dev/with-cargo-lock.sh cargo fmt --check *)",
      "Bash(uvx ruff@0.16.7 check *)",
      "Bash(uvx ruff@0.16.7 format --check *)",
      "Bash(uv run --no-project --python 3.10 --with aioquic==1.3.0 * python -m unittest discover *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(cargo check *)",
      "PowerShell(cargo +1.85.0 check *)",
      "PowerShell(cargo clippy *)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo doc *)",
      "PowerShell(cargo fmt)",
      "PowerShell(cargo fmt --check *)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(gh release *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D *)",
      "PowerShell(gh release *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(cargo publish *)",
      "Bash(cargo yank *)",
      "Bash(cargo owner *)",
      "Bash(cargo login *)",
      "Bash(scripts/release/publish-crates.sh *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf .git)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(cargo publish *)",
      "PowerShell(cargo yank *)",
      "PowerShell(cargo owner *)",
      "PowerShell(cargo login *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-command.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-rust-format.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
