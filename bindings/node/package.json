{
  "name": "@byway/phantom",
  "version": "0.5.1",
  "private": true,
  "description": "Native Node.js adapter for Phantom",
  "license": "MIT OR Apache-2.0",
  "main": "index.cjs",
  "types": "index.d.ts",
  "files": ["index.cjs", "index.mjs", "index.d.ts", "index.d.cts", "index.d.mts", "README.md", "lib"],
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs", "require": "./index.cjs" }
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "copy-native": "node scripts/copy-native.cjs",
    "test": "node --test --test-concurrency=1 --test-reporter=tap tests/*.test.cjs",
    "check-types": "tsc --noEmit --strict --module NodeNext --target ES2022 --lib ES2022,ESNext.Disposable tests/types.cts tests/types.mts && npm run check-facade",
    "check-facade": "tsc -p tsconfig.facade.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "ws": "8.22.0"
  }
}
