  "findings": [
    {
      "id": "HB1",
      "severity": "P2",
      "owner": "crates/phantom/tests/support/masque.rs",
      "title": "Own and cancel every accepted H3 MASQUE connection",
      "cause": "spawn_on detaches serve_connection tasks. Drop aborts only the accept task. The close receiver is first polled in the accepted relay loop, after TLS, H3 bootstrap, first request and rejected/challenged response waits. Retained QUIC connection references keep the endpoint driver alive; EndpointRef Drop only wakes it.",
      "independent_contract": "MasqueProxy documents abort on drop and close_connections closes every open outer connection. A TLS-authenticated peer held alive without first CONNECT or after receiving rejection must observe closure and allow the old listening UDP address to be rebound, while its endpoint/runtime remains alive.",
      "source_ranges": [
        [
          130,
          152
        ],
