  "findings": [
    {
      "id": "CERT-ORACLE-F1",
      "priority": "medium",
      "status": "source-supported TCP missing-certificate oracle gap; not a production defect",
      "path": "crates/phantom/tests/requests/client_certificates.rs",
      "ranges": [
        [
          206,
          238
        ],
        [
          86,
          96
        ]
      ],
      "cause": "served.is_err accepts every serve_one failure, including accept IO, TLS configuration/protocol, read_head and response write failures. Coarse client Tls/Http1 categories do not attribute rejection to absent client certificate.",
      "remedy": "Retain typed server accept failure and assert actual missing-client-certificate backend reason for each version, preserving coarse public category as a separate timing assertion. Distinguish handshake from later IO phases without copying a TLS server.",
      "regression": "Actual trusted client/server handshake readiness plus canonical missing-certificate path should satisfy typed rejection. A controlled unrelated accept/read failure and actual unrelated TLS rejection through the same observation boundary must fail the oracle. Source-pin named reason constants; no arbitrary numeric/error-string acceptance."
    },
    {
      "id": "CERT-ORACLE-F2",
      "priority": "medium",
      "status": "source-supported QUIC missing-certificate oracle gap; not a production defect",
      "path": "crates/phantom/tests/requests/client_certificates.rs",
      "ranges": [
        [
          713,
          742
        ],
        [
          644,
          667
        ]
      ],
      "cause": "The QUIC test discards the entire server result and accepts any client Tls/Http3 failure. Timeout and unrelated TLS/HTTP3 connection failure can have the same public category without proving required client authentication.",
      "remedy": "Observe server error as typed quinn::ConnectionError::TransportError with crypto CertificateRequired code, from the existing actual rustls verifier path. Preserve client category and positive presented-leaf control; do not require downcast to rustls error after Quinn intentionally maps it into typed transport code plus textual reason.",
      "regression": "Actual required-cert server with no client certificate versus same successful leaf positive; an unrelated TLS fatal alert/protocol/endpoint failure must not count as certificate-required. Observe real handshake and error codes, not copied parser or broad is_err."
    },
    {
      "id": "CERT-CALLER-F3",
      "priority": "medium",
      "status": "source-supported remaining caller completed-result/explicit cleanup gap; no observed permanent leak",
      "paths": [
        "crates/phantom/tests/requests/client_certificates.rs",
        "crates/phantom/tests/requests/client_certificates/per_origin.rs"
      ],
      "ranges": {
        "parent": [
          [
            162,
            202
          ]
        ],
        "per_origin": [
          [
            454,
            480
          ],
          [
            484,
            521
          ],
          [
            524,
            564
          ]
        ]
      },
      "cause": "HTTPS proxy/WSS tasks are eagerly ConnectionPeer-owned, but early client/serve/setup failures return before awaiting/stopping those peers. Drop requests abort without joining or observing already completed typed results. A primary error can hide an independent completed proxy/echo failure. Existing repaired ConnectionPeer and inner echo ownership must remain unchanged.",
      "remedy": "Prepare fallible inputs before spawn where possible; for these actual callers collect request result, explicitly stop/observe acquired peer on every recoverable exit and combine using existing finish_with_cleanup while retaining client until cleanup. No new general fixture framework.",
      "regression": "Drive actual CONNECT/TLS204 or WSS opening/echo first, retain Client/runtime externally, then create independent completed peer failure and primary operation failure; require both original typed objects and explicit finite peer observation. Cancellation Drop remains abort-only and must not be advertised as joined cleanup."
    }
  ],
  "accepted_or_rejected_candidates": [
    "No raw detached task in the two full owners.",
    "Existing abort-on-Drop does not prove joined cleanup or retained completed outcomes.",
    "Existing SOCKS caller and repaired ConnectionPeer/inner H2 echo contracts not reopened.",
    "Missing-cert public categories are intentionally timing-variable; they are insufficient as sole cause evidence.",
    "Intentional incomplete ClientHello request errors are not a successful-request contract.",
    "Documented HelloShape normalization is not full raw fingerprint parity.",
    "Version_information partial-word normalization not promoted to a new finding without an actual supported malformed-input contract.",
    "No secrets logged in owned sources; no global diagnostic review claim.",
    "No size-only module split or generic framework recommended."
  ],
  "limitations": [
    "No runtime, suite, lint, Cargo, process or socket execution by reviewer.",
    "No actual missing-certificate reason was measured on Windows/Linux.",
    "Rustls source is resolved by exact Cargo.lock version; local cached package tar not independently verified.",
    "Pinned native Git source is supporting partial, not generated build-source identity or whole vendor audit.",
    "Full current owner reads do not grant broader production/architecture/final-gate approval."
