  "findings": [
    {
      "id": "ALPS-REMEDY-I1",
      "priority": "high",
      "status": "source-supported request changes; no measured hang",
      "source_ranges": [
        [
          244,
          264
        ],
        [
          278,
          319
        ]
      ],
      "cause": "Cleanup uses Thread.ident/is_alive as sufficient stream-quiescence evidence. CPython3.10.20 Thread._wait_for_tstate_lock1119\u20131127 can set stopped after a KeyboardInterrupt while the native target remains active; Thread.is_alive1178 then returns false. A start interrupted before bootstrap can also leave ident None while an acquired thread is pending. close can consequently call TextIO.close under an active or uncertain reader despite its explicit no-live-close invariant.",
      "remedy": "Publish a concrete per-reader target completion witness in finally, record start-attempt uncertainty before start, and refuse stream closure/publication until target completion is proved; retain uncertain owners and original interruption plus secondary causes. Do not mutate CPython private thread registries or claim forced reader termination.",
      "meaningful_control": "Drive an actual live/held nonempty read with real child pipes, then a documented controlled interrupted-start/join bookkeeping fault or actual bounded signal. Before backup, require finite caller completion, no fixture, no premature TextIO.close, original interruption and retained reader owner. Always release/kill/wait/join backup. If fault is simulated, label it controlled rather than measured native interruption."
    },
    {
      "id": "ALPS-REMEDY-I2",
      "priority": "medium",
      "status": "source-supported first-interruption identity gap",
      "source_ranges": [
        [
          285,
          294
        ],
        [
          313,
          319
        ]
      ],
      "cause": "A first KeyboardInterrupt arising only during cleanup is caught into failures while primary is None, then replaced as the outer exception by _CaptureCleanupError. An existing main-operation primary is preserved, so this finding is specifically the first interruption in cleanup, not total causal erasure.",
      "remedy": "Retain the first actual parent interruption as primary while collecting all subsequent failures with operation/owner context.",
      "meaningful_control": "After a healthy actual exchange, inject one known KeyboardInterrupt object at an actual cleanup operation and a distinct cleanup failure; require outer identity is the interrupt and secondary object/owner survives."
    }
  ],
